---
// Scene III: The Dressing Room. Her bulb-lit mirror with everyone's notes tucked into the
// frame, the way opening-night cards are left for the star. Every note is open: guests just
// read down. Friends who sent their notes together are clipped into one bundle on the mirror.
import type { ImageMetadata } from 'astro';
import { Picture } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Gate from '../components/Gate.astro';
import FindKey from '../components/games/FindKey.astro';
import GuideDock from '../components/GuideDock.astro';
import Note from '../components/Note.astro';
import { lines } from '../../content/host';
import { awaiting, groupPhotos, messages } from '../../content/messages';
import { site } from '../../content/site';
import type { BirthdayMessage } from '../../content/types';
import { findPhoto, showPlaceholders } from '../lib/content';
import { rooms } from '../lib/rooms';

type Note = BirthdayMessage & { placeholder?: boolean };

// Real messages only. While developing, notes still on their way get a stamped stand-in in
// their place; with no messages at all, eight stand-ins show the layout.
const stillToCome: Note[] = showPlaceholders
  ? awaiting.map((a, k) => ({
      id: `awaiting-${k + 1}`,
      name: a.name,
      group: a.group,
      message: `${a.name}’s note goes here once it arrives.\n\nAdd it in content/messages.ts.`,
      placeholder: true,
    }))
  : [];
const notes: Note[] = messages.length || stillToCome.length
  ? [...messages, ...stillToCome]
  : showPlaceholders
    ? Array.from({ length: 8 }, (_, k) => ({
        id: `placeholder-${k + 1}`,
        name: 'Placeholder',
        message: 'A real message from someone who knows her goes here.\n\nAdd messages in content/messages.ts.',
        placeholder: true,
      }))
    : [];

// Everything goes on one mirror, in the order of content/messages.ts. Notes that share a
// group are gathered into one bundle where the first of them appears.
type Bundle = { name: string; notes: Note[]; photo: { image: ImageMetadata; alt: string; focus: string } | null };
type Slot = { note: Note } | { bundle: Bundle };
const slots: Slot[] = [];
for (const note of notes) {
  const name = note.group?.trim();
  if (!name) { slots.push({ note }); continue; }
  const found = slots.find((s): s is { bundle: Bundle } => 'bundle' in s && s.bundle.name === name);
  if (found) { found.bundle.notes.push(note); continue; }
  const shared = groupPhotos.find((g) => g.group.trim() === name);
  const image = shared ? findPhoto(shared.file) : null;
  slots.push({ bundle: { name, notes: [note], photo: shared && image ? { image, alt: shared.alt, focus: shared.focus ?? '50% 40%' } : null } });
}
const tilts = [-2.2, 1.6, -1, 2.4, -1.8, 1.1, -2.6, 1.9, -0.8, 2.1];
let t = 0;
const tilt = () => tilts[t++ % tilts.length]!;
---

<Base title={rooms.dressing.name} stop="dressing">
  <Gate stop="dressing" title="Find the key" line={lines.doors.dressing}>
    <FindKey />
  </Gate>
  <div data-gated-room="dressing">
  <div class="room">
    <article class="page dressing" data-dressing>
      <header class="head">
        <p class="kicker">Scene III · Backstage</p>
        <h1 class="title">{rooms.dressing.name}</h1>
        <p class="sub">Notes tucked into her mirror, from the people who know her best.</p>
      </header>

      <div class="mirror">
        <div class="glass">
          <ul class="notes" aria-label={`${notes.length} ${notes.length === 1 ? 'note' : 'notes'}`}>
            {slots.map((slot) =>
              'note' in slot ? (
                <li><Note note={slot.note} tilt={tilt()} /></li>
              ) : (
                <li class="bundle-slot">
                  <section class="bundle" aria-label={`From ${slot.bundle.name}`}>
                    <p class="bundle-tag">
                      <span class="bundle-name">{slot.bundle.name}</span>
                      <span class="bundle-count">{slot.bundle.notes.length} {slot.bundle.notes.length === 1 ? 'note' : 'notes'}</span>
                    </p>
                    {slot.bundle.photo && (
                      <figure class="booth">
                        <span class="tape" aria-hidden="true"></span>
                        <Picture
                          src={slot.bundle.photo.image}
                          alt={slot.bundle.photo.alt}
                          widths={[320, slot.bundle.photo.image.width]}
                          sizes="(min-width: 40rem) 24rem, 80vw"
                          formats={['avif', 'webp']}
                          style={`object-position: ${slot.bundle.photo.focus}`}
                        />
                      </figure>
                    )}
                    <ul class="notes">
                      {slot.bundle.notes.map((n) => <li><Note note={n} tilt={tilt()} /></li>)}
                    </ul>
                  </section>
                </li>
              ),
            )}
          </ul>
        </div>
      </div>

      {site.favourites.length > 0 && (
        <div class="table">
          <p class="kicker">On her dressing table</p>
          <ul class="tags">{site.favourites.map((thing) => <li>{thing}</li>)}</ul>
        </div>
      )}

      <div data-dock-end aria-hidden="true"></div>
    </article>
  </div>

  <GuideDock
    room="dressing"
    todo={lines.dressingRoom.todo}
    arrive={lines.dressingRoom.arrive}
    next={{ line: lines.dressingRoom.next, label: `Follow me: ${rooms.wings.name}`, href: rooms.wings.href, room: rooms.wings.name }}
  />
  </div>
</Base>

<script>
  import { markVisited } from '../lib/progress';
  import { onPage } from '../lib/page';

  // Everything is on the mirror already; Ambrose leads on once the guest reaches the end.
  onPage(() => {
    if (document.querySelector('[data-dressing]')) markVisited('dressing');
  });
</script>

<style>
  /* Warm backstage light. */
  .room {
    min-height: calc(100dvh - var(--chrome-h));
    background:
      radial-gradient(ellipse 80% 50% at 50% 45%, color-mix(in srgb, var(--edge) 90%, transparent), transparent 75%),
      color-mix(in srgb, var(--card) 60%, var(--paper));
  }
  .dressing { display: grid; gap: 1.75rem; }
  .head { display: grid; gap: .5rem; }
  .sub { font-size: 1.08rem; color: var(--ink-2); }

  /* ---- the mirror and its bulbs ---- */
  .mirror {
    --bulb: radial-gradient(circle, var(--edge) 0 5px, var(--ink) 5.5px 6.5px, transparent 7px);
    position: relative;
    padding: 1.6rem;
    border: 2px solid var(--ink);
    /* Bulbs along the top and bottom, spaced so none is cut off at an edge… */
    background:
      var(--bulb) 0 0 / 2.6rem 1.6rem space no-repeat,
      var(--bulb) 0 100% / 2.6rem 1.6rem space no-repeat,
      var(--card);
    box-shadow:
      0 0 0 5px var(--card),
      0 0 0 6.5px var(--ink),
      0 0 60px 10px color-mix(in srgb, var(--edge) 90%, transparent),
      0 18px 34px color-mix(in srgb, var(--ink) 18%, transparent);
  }
  /* …and down the sides, starting below the top row so the corners don't collide. */
  .mirror::before {
    content: '';
    position: absolute;
    inset: 1.6rem 0;
    pointer-events: none;
    background:
      var(--bulb) 0 0 / 1.6rem 2.6rem no-repeat space,
      var(--bulb) 100% 0 / 1.6rem 2.6rem no-repeat space;
  }
  .glass {
    position: relative;
    padding: clamp(1rem, 4vw, 1.75rem) clamp(.8rem, 3vw, 1.5rem) clamp(1.25rem, 4vw, 2rem);
    border: 1px solid var(--ink);
    background:
      linear-gradient(125deg, transparent 0 38%, color-mix(in srgb, var(--edge) 85%, transparent) 38% 44%, transparent 44% 52%, color-mix(in srgb, var(--edge) 60%, transparent) 52% 55%, transparent 55%),
      linear-gradient(180deg, var(--paper), color-mix(in srgb, var(--card) 50%, var(--paper)));
  }
  /* A photo the whole circle sent together, taped to the top of the glass. */
  .booth {
    position: relative;
    width: min(100%, 24rem);
    margin: .3rem auto 1.9rem;
    padding: .45rem .45rem 1.3rem;
    background: var(--edge);
    rotate: -1.4deg;
    box-shadow: 0 2px 3px color-mix(in srgb, var(--ink) 14%, transparent), 0 12px 24px color-mix(in srgb, var(--ink) 18%, transparent);
  }
  .booth :global(img) { display: block; width: 100%; height: auto; }
  /* One note under another on phones. */
  .notes {
    list-style: none;
    margin: 0;
    padding: .4rem 0 0;
  }
  /* The padding keeps each note's tape inside its own slot. */
  .notes > li { padding-top: .6rem; margin-bottom: 1.4rem; }
  .notes > li:last-child { margin-bottom: 0; }
  /* Wider screens: two side by side, reading left to right; a bundle takes the full width. */
  @media (min-width: 720px) {
    .notes { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 1.4rem 1.5rem; align-items: start; }
    .notes > li { margin: 0; }
    .notes > .bundle-slot { grid-column: 1 / -1; }
  }

  /* ---- a bundle: friends who sent their notes together, clipped as one ---- */
  .bundle-slot { padding-top: 1.1rem; }
  .bundle {
    position: relative;
    padding: 1.6rem clamp(.7rem, 3vw, 1.3rem) clamp(1rem, 3vw, 1.4rem);
    border: 1.5px dashed color-mix(in srgb, var(--ink) 55%, transparent);
    background: color-mix(in srgb, var(--card) 45%, transparent);
  }
  /* The name tag, hung over the top edge. */
  .bundle-tag {
    position: absolute;
    top: 0;
    left: clamp(.7rem, 3vw, 1.3rem);
    translate: 0 -50%;
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: .15rem .6rem;
    max-width: calc(100% - 1.4rem);
    padding: .35rem .8rem .4rem 1.15rem;
    background: var(--pink);
    border: 1.5px solid var(--ink);
    clip-path: polygon(10px 0, 100% 0, 100% 100%, 10px 100%, 0 50%);
    rotate: -1.5deg;
  }
  .bundle-name { font: italic 600 1.12rem/1.1 var(--font-display); color: var(--deep); }
  .bundle-count {
    font: 700 .66rem/1 var(--font-ui);
    letter-spacing: .14em;
    text-transform: uppercase;
    color: var(--cherry);
  }
  /* The photo they sent together, taped on top of their notes. */
  .booth {
    position: relative;
    width: min(100%, 24rem);
    margin: .6rem auto 1.6rem;
    padding: .45rem .45rem 1.3rem;
    background: var(--edge);
    rotate: -1.4deg;
    box-shadow: 0 2px 3px color-mix(in srgb, var(--ink) 14%, transparent), 0 12px 24px color-mix(in srgb, var(--ink) 18%, transparent);
  }
  .booth :global(img) { display: block; width: 100%; height: auto; }
  .tape {
    position: absolute;
    top: -9px;
    left: 50%;
    width: 3.2rem;
    height: 1rem;
    translate: -50% 0;
    rotate: -3deg;
    background: color-mix(in srgb, var(--card) 80%, transparent);
    border: 1px solid color-mix(in srgb, var(--ink) 12%, transparent);
  }

  /* ---- her dressing table ---- */
  .table {
    display: grid;
    gap: .75rem;
    padding: 1rem 1.1rem 1.2rem;
    border-top: 6px solid var(--ink);
    background: var(--card);
  }
  .tags { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; gap: .6rem; }
  .tags li {
    padding: .4rem .7rem .4rem 1.1rem;
    background: var(--edge);
    border: 1px solid var(--ink);
    font: italic 500 .98rem/1.2 var(--font-display);
    clip-path: polygon(10px 0, 100% 0, 100% 100%, 10px 100%, 0 50%);
  }

</style>
