---
// Scene IV: The Wings. Off to the side of the stage, in the dark, one work light
// over a letter. The quietest room: Ambrose says one line and waits by the door.
import Base from '../layouts/Base.astro';
import Gate from '../components/Gate.astro';
import Memory from '../components/games/Memory.astro';
import GuideDock from '../components/GuideDock.astro';
import Print from '../components/Print.astro';
import { letter } from '../../content/letter';
import { lines } from '../../content/host';
import { site } from '../../content/site';
import { findPhoto, showPlaceholders } from '../lib/content';
import { rooms, stage } from '../lib/rooms';

const photo = letter.photo ? findPhoto(letter.photo.file) : null;
const signature = letter.signature ?? site.creator;
const listenOn = site.song.url?.includes('spotify')
  ? 'Listen on Spotify'
  : site.song.url?.includes('youtu')
    ? 'Listen on YouTube'
    : 'Listen';
---

<Base title={rooms.wings.name} tone="night" stop="wings">
  <Gate stop="wings" title="Light the lamp" line={lines.doors.wings} tone="night">
    <Memory />
  </Gate>
  <div data-gated-room="wings">
  <div class="wings" data-wings data-music-level="0.45">
    <svg class="lamp" viewBox="0 0 120 260" aria-hidden="true">
      <path d="M40 255 L60 236 L80 255" fill="none" stroke="#F0E9D9" stroke-width="2.4" stroke-linejoin="round" />
      <line x1="60" y1="236" x2="60" y2="58" stroke="#F0E9D9" stroke-width="3" />
      <path d="M60 58 L84 46" stroke="#F0E9D9" stroke-width="3" />
      <circle cx="92" cy="44" r="13" fill="#F7F2E6" stroke="#F0E9D9" stroke-width="2" />
      <path d="M79 44 H105 M92 31 V57 M83 35 L101 53 M101 35 L83 53" stroke="#4B3F3B" stroke-width="1" />
    </svg>
    <div class="light" aria-hidden="true"></div>

    <article class="page room">
      <header class="head">
        <p class="kicker">Scene IV · Offstage</p>
        <h1 class="title">{rooms.wings.name}</h1>
      </header>

      <div class="letter">
        {letter.photo && (
          <Print
            class="pinned"
            image={photo}
            alt={letter.photo.alt}
            caption={letter.photo.caption}
            focus={letter.photo.focus}
            needed="The optional photo for this corner: add it in content/letter.ts"
            sizes="10rem"
          />
        )}
        {letter.paragraphs?.length ? (
          <div class="words">{letter.paragraphs.map((p) => <p>{p}</p>)}</div>
        ) : (
          showPlaceholders && (
            <p class="placeholder">
              <span class="stamp">Placeholder</span>
              {site.creator}’s letter to {site.subject} goes here. Nobody else writes it. Add it in content/letter.ts.
            </p>
          )
        )}
        <p class="signed">{signature}</p>
      </div>

      {site.song.url && (
        <a class="record" href={site.song.url} target="_blank" rel="noopener noreferrer">
          <span class="disc" aria-hidden="true"></span>
          <span class="label">
            <span class="k">Playing in the wings</span>
            <span class="t">{site.song.title}</span>
            <span class="a">{site.song.artist}</span>
            <span class="cta">{listenOn} <span aria-hidden="true">↗</span></span>
          </span>
        </a>
      )}

      <div data-dock-end aria-hidden="true"></div>
    </article>
  </div>

  <GuideDock
    room="wings"
    todo={lines.wings.todo}
    arrive={lines.wings.arrive}
    pose="chest"
    next={{ line: lines.wings.next, label: `Follow me: ${stage.name}`, href: stage.href, room: stage.name }}
  />
  </div>
</Base>

<script>
  import { markVisited } from '../lib/progress';
  import { onPage } from '../lib/page';

  onPage(() => {
    if (document.querySelector('[data-wings]')) markVisited('wings');
  });
</script>

<style>
  .wings {
    position: relative;
    overflow: hidden;
    min-height: calc(100dvh - var(--chrome-h));
    background:
      radial-gradient(ellipse 70% 45% at 50% 30%, color-mix(in srgb, var(--deep) 60%, transparent), transparent 80%),
      var(--ink);
  }
  .lamp {
    position: absolute;
    top: .75rem;
    left: max(-1.5rem, calc((100% - 72rem) / 2 - 1rem));
    width: clamp(4.5rem, 16vw, 7rem);
    height: auto;
    opacity: .9;
  }
  /* The work light's pool, falling across the letter. */
  .light {
    position: absolute;
    inset: 0;
    background: radial-gradient(ellipse 65% 50% at 32% 28%, color-mix(in srgb, var(--edge) 22%, transparent), transparent 70%);
    pointer-events: none;
  }

  .room { position: relative; display: grid; gap: 2rem; justify-items: center; }
  .head { display: grid; gap: .5rem; justify-self: stretch; padding-left: clamp(3.5rem, 14vw, 5rem); }

  .letter {
    position: relative;
    width: min(100%, 34rem);
    padding: clamp(1.6rem, 6vw, 2.6rem) clamp(1.3rem, 5vw, 2.4rem) clamp(1.4rem, 5vw, 2rem);
    background: var(--edge);
    color: var(--ink);
    rotate: .4deg;
    box-shadow: 0 2px 3px color-mix(in srgb, var(--ink) 30%, transparent), 0 26px 50px color-mix(in srgb, var(--ink) 70%, transparent);
  }
  .letter > :global(.pinned) {
    float: right;
    width: clamp(7rem, 30vw, 10rem);
    margin: -2.6rem -1.4rem .8rem 1rem;
    rotate: 4deg;
  }
  .words { display: grid; gap: 1rem; font-size: 1.16rem; line-height: 1.75; }
  .signed {
    clear: both;
    margin-top: 1.6rem;
    text-align: right;
    font: italic 500 1.5rem/1 var(--font-display);
    color: var(--cherry);
  }
  .placeholder { font: 500 .95rem/1.55 var(--font-ui); color: var(--ink-2); border: 1.5px dashed var(--cherry); padding: 1rem; }
  .stamp {
    display: inline-block;
    margin-right: .5rem;
    padding: .25rem .45rem;
    border: 2px solid var(--cherry);
    color: var(--cherry);
    font: 700 .66rem/1 var(--font-ui);
    letter-spacing: .2em;
    text-transform: uppercase;
  }

  /* ---- the record ---- */
  .record {
    display: flex;
    align-items: center;
    gap: 1rem;
    width: min(100%, 34rem);
    padding: .6rem 0;
    color: var(--paper);
    text-decoration: none;
  }
  .disc {
    flex: none;
    width: 4.2rem;
    aspect-ratio: 1;
    border-radius: 50%;
    background:
      radial-gradient(circle, var(--ink) 0 3px, var(--pink) 3.5px 9px, var(--cherry) 9.5px 18px, transparent 18.5px),
      repeating-radial-gradient(circle, color-mix(in srgb, var(--ink) 85%, var(--paper)) 0 1px, var(--ink) 1px 3px);
    box-shadow: 0 0 0 1px color-mix(in srgb, var(--paper) 25%, transparent);
    transition: rotate 1.2s var(--ease-paper);
  }
  @media (hover: hover) { .record:hover .disc { rotate: 200deg; } }
  .label { display: grid; gap: .1rem; }
  .k { font: 600 .72rem/1.2 var(--font-ui); font-stretch: 78%; letter-spacing: .18em; text-transform: uppercase; color: var(--pink); }
  .t { font: italic 500 1.3rem/1.1 var(--font-display); }
  .a { font: 500 .85rem/1.3 var(--font-ui); color: color-mix(in srgb, var(--paper) 80%, transparent); }
  .cta { margin-top: .25rem; font: 600 .78rem/1.2 var(--font-ui); text-decoration: underline; text-underline-offset: .25em; }
</style>
