---
// Scene I: Enter the Host. Ambrose in front of the closed curtain, with a little
// stage business on each card (a bow, a wobbling shoe, a twitch of the curtain).
import Base from '../layouts/Base.astro';
import Ambrose from '../components/Ambrose.astro';
import CueCards from '../components/CueCards.astro';
import StageSet from '../components/StageSet.astro';
import { lines } from '../../content/host';
import { site } from '../../content/site';
import { rooms, tour } from '../lib/rooms';

const firstRoom = rooms[tour[0]!];
---

<Base title="Enter the Host" tone="night">
  <h1 class="visually-hidden">Enter the Host</h1>
  <StageSet>
    <Ambrose slot="host" pose={lines.intro[0]!.pose} />
    <div class="cards" data-intro>
      <CueCards cues={lines.intro} doneLabel="Follow me" doneHref={firstRoom.href} skipHref={firstRoom.href} />
    </div>
    <div class="cards" data-return data-after-line={lines.stageAfter} hidden>
      <CueCards cues={[{ say: lines.stageReturn, pose: 'point' }]} doneLabel="Back to the tour" doneHref={firstRoom.href} />
      <button type="button" class="btn ghost replay" data-replay>Hear {site.host}’s introduction again</button>
    </div>
  </StageSet>
</Base>

<script>
  import { navigate } from 'astro:transitions/client';
  import type { Cue, Pose } from '../../content/types';
  import { markIntroSeen, readProgress, resumeHref, tourFinished } from '../lib/progress';
  import { reducedMotion } from '../lib/motion';
  import { later, onPage } from '../lib/page';
  import { play } from '../lib/sound';

  onPage((signal) => {
    const intro = document.querySelector<HTMLElement>('[data-intro]');
    if (!intro) return;
    const stage = document.querySelector<HTMLElement>('[data-stage]')!;
    const host = document.querySelector<HTMLElement>('[data-host]')!;
    const ambrose = host.querySelector<SVGElement>('[data-ambrose]')!;
    const back = document.querySelector<HTMLElement>('[data-return]')!;
    const progress = readProgress();

    if (progress.introSeen) {
      intro.hidden = true;
      back.hidden = false;
      host.classList.add('is-here');
      // Pick the tour up where this guest left it; after the show, back to the house.
      const cues = back.querySelector<HTMLElement>('[data-cues]')!;
      cues.dataset.doneHref = resumeHref(progress);
      if (tourFinished(progress)) {
        cues.querySelector('[data-line]')!.textContent = back.dataset.afterLine ?? '';
        cues.querySelector('[data-next]')!.textContent = 'Back to the house';
      }
    }

    // His chime once he has walked on (or straight away if he's already there).
    later(signal, progress.introSeen ? 300 : 1200, () => play('host'));

    const flash = (el: Element, cls: string, ms: number) => {
      el.classList.add(cls);
      later(signal, ms, () => el.classList.remove(cls));
    };

    let straighten = 0;
    signal.addEventListener('abort', () => window.clearTimeout(straighten));
    const strike = (pose: Pose) => {
      window.clearTimeout(straighten);
      ambrose.dataset.pose = pose;
      // A bow is a moment, not a stance.
      if (pose === 'bow') straighten = window.setTimeout(() => { ambrose.dataset.pose = 'welcome'; }, 1100);
    };

    // His stage business for each card.
    document.addEventListener('cues:line', (e) => {
      const { cue } = (e as CustomEvent<{ cue: Cue }>).detail;
      if (cue.pose) strike(cue.pose);
      if (reducedMotion()) return;
      if (cue.action === 'shoe') later(signal, 900, () => flash(ambrose, 'is-shoe', 800));
      if (cue.action === 'curtain') later(signal, 700, () => flash(stage, 'is-twitch', 1000));
      host.animate([{ rotate: '0deg' }, { rotate: '-2.5deg' }, { rotate: '1.4deg' }, { rotate: '0deg' }], {
        duration: 460,
        easing: 'ease-in-out',
      });
    }, { signal });

    // "Follow me": he walks off into the wings before the next room appears.
    const exit = (e: Event) => {
      markIntroSeen();
      if (reducedMotion()) return;
      e.preventDefault();
      const href = (e.target as HTMLElement).dataset.doneHref ?? '/house';
      strike('point');
      host.classList.add('is-leaving');
      later(signal, 520, () => void navigate(href));
    };
    intro.addEventListener('cues:done', exit, { signal });
    intro.addEventListener('cues:skip', exit, { signal });

    document.querySelector('[data-replay]')!.addEventListener('click', () => {
      back.hidden = true;
      intro.hidden = false;
      intro.querySelector('[data-cues]')!.dispatchEvent(new Event('cues:restart'));
    }, { signal });
  });
</script>

<style>
  .cards { display: grid; justify-items: center; gap: .8rem; width: 100%; }
  .cards > :global(.cues) { width: 100%; }
  /* The apron is card, not curtain, so its ghost button keeps cherry ink. */
  :global(html[data-tone='night']) .cards .replay { color: var(--cherry); }
</style>
