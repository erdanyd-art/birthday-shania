---
// The one switch for sound. Off unless the guest turns it on.
interface Props {
  class?: string;
  /** Keep the words visible on phones too (the entrance, where the choice matters most). */
  labelled?: boolean;
}

const { class: className, labelled = false } = Astro.props;
---

<button type="button" class:list={['sound', { labelled }, className]} data-sound aria-pressed="true">
  <svg viewBox="0 0 20 20" width="18" height="18" aria-hidden="true">
    <path d="M3 8 H6 L10.5 4.5 V15.5 L6 12 H3 Z" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round" />
    <path class="waves" d="M13 7.5 C14.4 9 14.4 11 13 12.5 M15.4 5.6 C17.8 8.2 17.8 11.8 15.4 14.4" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" />
    <path class="mute" d="M13.5 7.8 L17.5 12.2 M17.5 7.8 L13.5 12.2" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" />
  </svg>
  <span data-sound-label>Music on</span>
</button>

<script>
  import { onPage } from '../lib/page';
  import { play, setSound, soundOn } from '../lib/sound';

  onPage((signal) => {
    for (const button of document.querySelectorAll<HTMLButtonElement>('[data-sound]')) {
      const label = button.querySelector('[data-sound-label]')!;
      const show = (on: boolean) => {
        button.setAttribute('aria-pressed', String(on));
        label.textContent = on ? 'Music on' : 'Music off';
      };
      show(soundOn());
      button.addEventListener('click', () => {
        const on = !soundOn();
        setSound(on);
        show(on);
        if (on) play('paper');
      }, { signal });
    }
  });
</script>

<style>
  .sound {
    display: inline-flex;
    align-items: center;
    gap: .4rem;
    min-height: 44px;
    min-width: 44px;
    justify-content: center;
    padding: 0 .35rem;
    border: 0;
    background: none;
    cursor: pointer;
    color: inherit;
    font: 600 .7rem/1 var(--font-ui);
    font-stretch: 78%;
    letter-spacing: .16em;
    text-transform: uppercase;
  }
  /* On phones the icon carries it; the words stay for screen readers. */
  @media (max-width: 600px) {
    .sound:not(.labelled) span {
      position: absolute; width: 1px; height: 1px; overflow: hidden;
      clip-path: inset(50%); white-space: nowrap;
    }
  }
  .waves { display: none; }
  .sound[aria-pressed='true'] .waves { display: inline; }
  .sound[aria-pressed='true'] .mute { display: none; }
</style>
