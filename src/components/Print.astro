---
// A photograph treated as a real print: white border, photo corners, a caption on the margin.
// Photos are never filtered. Missing photos become a stamped placeholder (dev and preview only;
// the launch build refuses to run without them).
import type { ImageMetadata } from 'astro';
import { Picture } from 'astro:assets';

interface Props {
  image: ImageMetadata | null;
  alt: string | null;
  caption: string;
  /** CSS object-position, from the content file. */
  focus?: string;
  /** What belongs here, shown on the placeholder. */
  needed: string;
  sizes?: string;
  class?: string;
  [key: `data-${string}`]: string | undefined;
}

const { image, alt, caption, focus = '50% 35%', needed, sizes = '(min-width: 60rem) 26rem, 72vw', class: className, ...rest } = Astro.props;
---

<figure class:list={['print', className]} {...rest}>
  <span class="corner tl"></span><span class="corner tr"></span>
  <span class="corner bl"></span><span class="corner br"></span>
  <div class="photo">
    {image && alt ? (
      <Picture
        src={image}
        alt={alt}
        widths={[360, 540, 720, 1080, 1440]}
        sizes={sizes}
        formats={['avif', 'webp']}
        style={`object-position:${focus}`}
        draggable="false"
      />
    ) : (
      <div class="placeholder" role="img" aria-label={`Placeholder: ${needed}`}>
        <span class="stamp">Placeholder</span>
        <span class="needed">{needed}</span>
      </div>
    )}
  </div>
  <figcaption>{caption}</figcaption>
</figure>

<style>
  .print {
    position: relative;
    margin: 0;
    background: var(--edge);
    padding: 3.4% 3.4% 13%;
    box-shadow:
      0 1px 1px color-mix(in srgb, var(--ink) 12%, transparent),
      0 12px 22px color-mix(in srgb, var(--ink) 18%, transparent);
  }
  .photo {
    aspect-ratio: 4 / 5;
    overflow: hidden;
    background: var(--card);
  }
  .photo :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    user-select: none;
    -webkit-user-drag: none;
  }
  .corner {
    position: absolute;
    width: 7%;
    aspect-ratio: 1;
    background: var(--ink);
  }
  .tl { top: 1.6%; left: 1.8%; clip-path: polygon(0 0, 100% 0, 0 100%); }
  .tr { top: 1.6%; right: 1.8%; clip-path: polygon(0 0, 100% 0, 100% 100%); }
  .bl { bottom: 11.4%; left: 1.8%; clip-path: polygon(0 0, 0 100%, 100% 100%); }
  .br { bottom: 11.4%; right: 1.8%; clip-path: polygon(100% 0, 100% 100%, 0 100%); }
  figcaption {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 3.2%;
    text-align: center;
    font: italic 480 clamp(.85rem, 4.2cqw, 1.2rem)/1 var(--font-display);
    color: var(--ink-2);
  }

  .placeholder {
    height: 100%;
    display: grid;
    align-content: center;
    justify-items: center;
    gap: .6rem;
    padding: 8%;
    text-align: center;
    background:
      repeating-linear-gradient(45deg, color-mix(in srgb, var(--ink) 13%, transparent) 0 1px, transparent 1px 7px),
      var(--card);
  }
  .stamp {
    padding: .3rem .55rem;
    border: 2px solid var(--cherry);
    color: var(--cherry);
    background: var(--edge);
    font: 700 .72rem/1 var(--font-ui);
    font-stretch: 80%;
    letter-spacing: .22em;
    text-transform: uppercase;
    rotate: -4deg;
  }
  .needed {
    max-width: 16em;
    font: 500 .78rem/1.4 var(--font-ui);
    color: var(--ink-2);
    background: color-mix(in srgb, var(--edge) 85%, transparent);
    padding: .2rem .4rem;
  }
</style>
