---
// Ambrose, docked at the foot of the screen while guests are in a room.
// He greets them, steps aside once they start reading, reacts when a page asks him to,
// and comes back at the end of the room to lead them on.
// The way on stays shut until the room is finished: until then the bar at the foot of the
// screen says what to do here, not where to go next.
// Pages talk to him through window events:
//   guide:say   { line, pose? }   he says something new
//   guide:ready                   the room's task is done (rooms with `waitFor`)
//   guide:lead                    he leads on now
// and by placing <div data-dock-end></div> where the room ends: once the guest reaches it
// (and the room is ready), he leads on. Leading on marks the room finished.
import Ambrose from './Ambrose.astro';
import { site } from '../../content/site';
import type { Pose } from '../../content/types';
import type { RoomId } from '../lib/rooms';

interface Props {
  room: RoomId;
  /** What to do in this room, shown at the foot of the screen until it's done. */
  todo: string;
  /** The room has a task: reaching the end isn't enough until the page sends guide:ready. */
  waitFor?: boolean;
  /** What he says as guests arrive. */
  arrive: string;
  /** What he says at the end, and where he leads. */
  next: { line: string; label: string; href: string; room: string };
  pose?: Pose;
}

const { room, todo, waitFor = false, arrive, next, pose = 'welcome' } = Astro.props;
---

<aside
  class="dock"
  data-dock
  data-state="open"
  data-room={room}
  data-wait={waitFor ? '' : undefined}
  data-next-line={next.line}
  aria-label={`${site.host}, your host`}
>
  <div class="panel" data-dock-panel>
    <div class="figure"><Ambrose wire={false} decorative pose={pose} /></div>
    <div class="speech">
      <div class="top">
        <p class="who">{site.host}</p>
        <button type="button" class="tuck" data-dock-tuck aria-label={`Hide ${site.host}`}>
          <svg viewBox="0 0 16 16" width="14" height="14" aria-hidden="true">
            <path d="M3.5 6 L8 10.5 L12.5 6" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" />
          </svg>
        </button>
      </div>
      <p class="voice line" data-dock-line aria-live="polite">{arrive}</p>
      <a class="go" href={next.href} data-dock-go>{next.label} <span aria-hidden="true">→</span></a>
    </div>
  </div>
  <!-- When he steps aside, this stays: him (tap to bring him back), and either what's left
       to do here or, once he has led on, the way to the next room. -->
  <div class="mini" data-dock-tab hidden>
    <button type="button" class="mini-host" data-dock-reopen aria-label={`Show ${site.host}`}>
      <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true">
        <path d="M7 15 L7.5 4.5 C10 3.6 14 3.6 16.5 4.2 L16.5 15 Z" fill="currentColor" />
        <path d="M4 16.5 C8 14.8 16 14.6 20 15.4 L20 17 C16 16.4 8 16.6 4.2 18.2 Z" fill="currentColor" />
      </svg>
      <span>{site.host}</span>
    </button>
    <button type="button" class="mini-todo" data-dock-reopen>
      <span class="mini-k">To do</span> <span class="todo-text">{todo}</span>
    </button>
    <a class="mini-go" href={next.href}><span class="mini-k">Next</span> {next.room} <span aria-hidden="true">→</span></a>
  </div>
</aside>

<script>
  import type { Pose } from '../../content/types';
  import { reducedMotion } from '../lib/motion';
  import { later, onPage } from '../lib/page';
  import { markDone, readProgress, roamFree } from '../lib/progress';
  import type { RoomId } from '../lib/rooms';
  import { play } from '../lib/sound';

  onPage((signal) => {
    const dock = document.querySelector<HTMLElement>('[data-dock]');
    if (!dock) return;

    const panel = dock.querySelector<HTMLElement>('[data-dock-panel]')!;
    const line = dock.querySelector<HTMLElement>('[data-dock-line]')!;
    const tab = dock.querySelector<HTMLElement>('[data-dock-tab]')!;
    const reopeners = tab.querySelectorAll<HTMLButtonElement>('[data-dock-reopen]');
    const figure = dock.querySelector<SVGElement>('[data-ambrose]')!;
    type State = 'open' | 'tucked' | 'lead';
    let state: State = 'open';
    let led = false;
    const room = dock.dataset.room as RoomId;
    // A room finished on an earlier visit keeps its way on open from the start.
    const finished = roamFree() || readProgress().done.includes(room);
    let ready = finished || !dock.hasAttribute('data-wait');
    let endVisible = false;
    // With the script running, the way on waits until he leads (see the CSS).
    dock.setAttribute('data-js', '');
    if (finished) dock.dataset.led = '';

    const wobble = () => {
      if (reducedMotion()) return;
      figure.animate(
        [{ rotate: '0deg' }, { rotate: '-3deg' }, { rotate: '1.5deg' }, { rotate: '0deg' }],
        { duration: 460, easing: 'ease-in-out' },
      );
    };

    const say = (text: string, pose?: Pose) => {
      line.textContent = text;
      play('host');
      if (pose) figure.dataset.pose = pose;
      // Back into view, with a fresh few seconds before he steps aside again.
      if (state !== 'lead') set(led ? 'lead' : 'open');
      if (!reducedMotion()) {
        line.animate([{ opacity: 0, transform: 'translateY(5px)' }, { opacity: 1, transform: 'none' }], {
          duration: 260,
          easing: 'cubic-bezier(.2,.75,.25,1)',
        });
      }
      wobble();
    };

    const lead = () => {
      if (led) return;
      led = true;
      markDone(room);
      dock.dataset.led = '';
      say(dock.dataset.nextLine ?? '', 'point');
      set('lead');
    };

    // He steps aside so he never covers the room: when the guest scrolls, taps anything
    // else, or after a few seconds. Whatever he says next brings him back.
    let openedAt = window.scrollY;
    let timer = 0;
    signal.addEventListener('abort', () => window.clearTimeout(timer));
    const tuckLater = () => {
      window.clearTimeout(timer);
      openedAt = window.scrollY;
      timer = window.setTimeout(() => { if (state === 'open') set('tucked'); }, 9000);
    };
    const set = (next: State) => {
      state = next;
      dock.dataset.state = next;
      tab.hidden = next !== 'tucked';
      panel.inert = next === 'tucked';
      if (next === 'open') tuckLater();
      else window.clearTimeout(timer);
    };
    set('open');
    // His chime as he steps up to greet the guest.
    later(signal, 700, () => play('host'));

    window.addEventListener('scroll', () => {
      if (state === 'open' && Math.abs(window.scrollY - openedAt) > 140) set('tucked');
    }, { passive: true, signal });
    document.addEventListener('pointerdown', (e) => {
      if (state === 'open' && !dock.contains(e.target as Node)) set('tucked');
    }, { signal });

    dock.querySelector('[data-dock-tuck]')!.addEventListener('click', () => set('tucked'), { signal });
    reopeners.forEach((b) => b.addEventListener('click', () => set(led ? 'lead' : 'open'), { signal }));

    window.addEventListener('guide:say', (e) => {
      const { line: text, pose } = (e as CustomEvent<{ line: string; pose?: Pose }>).detail;
      say(text, pose);
    }, { signal });
    window.addEventListener('guide:lead', lead, { signal });
    // The room's task is done. If the guest is already at the end, give his reaction a moment.
    window.addEventListener('guide:ready', () => {
      ready = true;
      if (endVisible) later(signal, 3500, () => { if (endVisible) lead(); });
    }, { signal });
    // Once the door's game is done and the room opens, he greets the guest properly.
    window.addEventListener('gate:open', () => say(line.textContent ?? ''), { signal });

    // At the end of the room he comes back to lead on. Give his greeting a moment first.
    const end = document.querySelector('[data-dock-end]');
    if (end && 'IntersectionObserver' in window) {
      later(signal, 4000, () => {
        const watch = new IntersectionObserver((entries) => {
          endVisible = entries.some((entry) => entry.isIntersecting);
          if (endVisible && ready) {
            lead();
            watch.disconnect();
          }
        }, { rootMargin: '0px 0px -15% 0px' });
        watch.observe(end);
        signal.addEventListener('abort', () => watch.disconnect());
      });
    }
  });
</script>

<style>
  /* The end of every room: room enough to scroll the last words clear of him. */
  :global([data-dock-end]) { height: 12rem; }

  .dock {
    position: fixed;
    z-index: 30;
    left: 0;
    right: 0;
    bottom: 0;
    padding: 0 var(--gutter-r) calc(env(safe-area-inset-bottom, 0px) + .75rem) var(--gutter-l);
    pointer-events: none;
  }
  @media (min-width: 900px) {
    .dock { padding-left: max(var(--gutter-l), calc((100% - 72rem) / 2 + 16px)); }
  }

  .panel {
    pointer-events: auto;
    display: grid;
    grid-template-columns: clamp(3.6rem, 16vw, 4.6rem) minmax(0, 1fr);
    gap: .7rem;
    align-items: end;
    width: min(100%, 31rem);
    transition: translate .4s var(--ease-paper), opacity .3s ease;
    animation: rise .6s var(--ease-arrive) .3s backwards;
  }
  @keyframes rise {
    from { translate: 0 120%; opacity: 0; }
    to { translate: 0 0; opacity: 1; }
  }
  .dock[data-state='tucked'] .panel { translate: 0 130%; opacity: 0; }

  .figure :global(svg) { width: 100%; height: auto; }

  .speech {
    position: relative;
    background: var(--card);
    color: var(--ink);
    border-top: 3px solid var(--cherry);
    padding: .65rem .9rem .8rem;
    margin-bottom: 1.4rem;
    box-shadow: 0 10px 26px color-mix(in srgb, var(--ink) 24%, transparent);
  }
  .speech::before {
    content: '';
    position: absolute;
    left: -11px;
    bottom: 1.3rem;
    width: 12px;
    height: 18px;
    background: var(--card);
    clip-path: polygon(100% 0, 0 55%, 100% 100%);
  }
  .top { display: flex; align-items: center; justify-content: space-between; }
  .who {
    font: 600 .74rem/1 var(--font-ui);
    font-stretch: 75%;
    letter-spacing: .24em;
    text-transform: uppercase;
    color: var(--cherry);
  }
  .tuck {
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    margin: -.75rem -.75rem -.6rem 0;
    border: 0;
    background: none;
    color: var(--ink-2);
    cursor: pointer;
  }
  .line { font-size: clamp(.98rem, 3.7vw, 1.14rem); line-height: 1.3; margin-top: .2rem; }

  /* Quietly there from the start; a proper button once he leads on. */
  .go {
    display: inline-flex;
    align-items: center;
    gap: .4rem;
    min-height: 44px;
    margin-top: .35rem;
    font: 600 .78rem/1.2 var(--font-ui);
    color: var(--cherry);
    text-decoration: underline;
    text-underline-offset: .25em;
  }
  /* On arrival he only greets: the way on appears when he leads, so nobody skips a room unseen. */
  .dock[data-js]:not([data-led])[data-state='open'] .go { display: none; }
  .dock[data-state='lead'] .go {
    margin-top: .6rem;
    padding: .75rem 1.05rem;
    background: var(--cherry);
    color: var(--paper);
    text-decoration: none;
    border-radius: 2px;
    font-size: .88rem;
  }
  .dock[data-state='lead'] .go:hover { background: var(--deep); }

  .mini {
    pointer-events: auto;
    position: absolute;
    left: var(--gutter-l);
    right: var(--gutter-r);
    bottom: calc(env(safe-area-inset-bottom, 0px) + .75rem);
    display: flex;
    max-width: 31rem;
    border: 1.5px solid var(--ink);
    border-radius: 999px;
    background: var(--card);
    color: var(--ink);
    box-shadow: 0 6px 16px color-mix(in srgb, var(--ink) 20%, transparent);
    overflow: hidden;
  }
  .mini-host {
    display: inline-flex;
    align-items: center;
    gap: .4rem;
    min-height: 46px;
    padding: 0 .8rem 0 .75rem;
    border: 0;
    border-right: 1px solid color-mix(in srgb, var(--ink) 30%, transparent);
    background: none;
    color: inherit;
    cursor: pointer;
    font: 600 .74rem/1 var(--font-ui);
    font-stretch: 78%;
    letter-spacing: .14em;
    text-transform: uppercase;
  }
  .mini-go {
    flex: 1;
    display: inline-flex;
    align-items: center;
    justify-content: flex-end;
    gap: .45rem;
    min-height: 46px;
    padding: 0 1rem;
    background: var(--cherry);
    color: var(--paper);
    text-decoration: none;
    font: 600 .86rem/1.1 var(--font-ui);
  }
  /* Before he leads on: what's left to do here. After: the way to the next room. */
  .dock:not([data-led]) .mini-go,
  .dock[data-led] .mini-todo { display: none; }
  .mini-todo {
    flex: 1;
    display: inline-flex;
    align-items: center;
    gap: .5rem;
    min-width: 0;
    min-height: 46px;
    padding: 0 1rem;
    border: 0;
    background: none;
    color: var(--ink);
    cursor: pointer;
    text-align: left;
    font: 600 .86rem/1.15 var(--font-ui);
  }
  .mini-todo .mini-k { color: var(--cherry); white-space: nowrap; }
  .todo-text { min-width: 0; }
  .mini-k {
    font-size: .7rem;
    font-stretch: 78%;
    letter-spacing: .14em;
    text-transform: uppercase;
    opacity: .85;
  }
  @media (min-width: 900px) {
    .mini { left: max(var(--gutter-l), calc((100% - 72rem) / 2 + 16px)); right: auto; width: 31rem; }
  }
</style>
