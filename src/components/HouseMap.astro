---
// The theatre cut open like a doll's house: the world map.
// Interactive on /house (each room is a link); decorative behind the entrance facade.
import { rooms, stage } from '../lib/rooms';

interface Props {
  interactive?: boolean;
  class?: string;
}

const { interactive = false, class: className } = Astro.props;
const uid = `hm-${Math.random().toString(36).slice(2, 8)}`;
const Room = interactive ? 'a' : 'g';
const link = (href: string, name: string, cx: number, cy: number) =>
  interactive ? { href, 'aria-label': name, 'data-name': name, 'data-cx': cx, 'data-cy': cy } : {};
const wash = `url(#${uid}-wash)`;
const hatch = `url(#${uid}-hatch)`;
---

<svg
  class:list={['house', className]}
  viewBox="0 0 360 486"
  role={interactive ? 'group' : undefined}
  aria-label={interactive ? 'The house, in section' : undefined}
  aria-hidden={interactive ? undefined : 'true'}
>
  <defs>
    <filter id={`${uid}-wash`} x="-5%" y="-5%" width="110%" height="110%">
      <feTurbulence type="fractalNoise" baseFrequency=".04" numOctaves="2" seed="7" />
      <feDisplacementMap in="SourceGraphic" scale="6" />
    </filter>
    <pattern id={`${uid}-hatch`} width="4" height="4" patternUnits="userSpaceOnUse" patternTransform="rotate(45)">
      <line x1="0" y1="0" x2="0" y2="4" stroke="#171717" stroke-width=".7" opacity=".45" />
    </pattern>
  </defs>

  <line x1="180" y1="16" x2="180" y2="2" stroke="#171717" stroke-width="1.4" />
  <path d="M180 2 L196 6 L180 10 Z" fill="#8F1D2C" />
  <path d="M8 132 L180 16 L352 132 Z" fill="#E9DDC7" stroke="#171717" stroke-width="2" />

  <!-- The Archive of Her: the attic -->
  <Room class="room" data-room="archive" {...link(rooms.archive.href, rooms.archive.name, 180, 90)}>
    <path d="M52 128 L180 40 L308 128 Z" fill="#F0E9D9" stroke="#171717" stroke-width="1.2" />
    <path class="wash" d="M60 126 L180 46 L300 126 Z" fill="#F2B6C3" filter={wash} />
    <line x1="180" y1="40" x2="180" y2="56" stroke="#171717" stroke-width="1" />
    <circle cx="180" cy="60" r="4" fill="#F0E9D9" stroke="#171717" stroke-width="1.1" />
    <g transform="rotate(-3 151 91)">
      <rect x="136" y="72" width="30" height="38" fill="#E9DDC7" stroke="#171717" stroke-width="1.2" />
      <rect x="140" y="76" width="22" height="26" fill={hatch} stroke="#171717" stroke-width=".6" />
    </g>
    <g transform="rotate(3 208 90)">
      <rect x="193" y="70" width="30" height="40" fill="#E9DDC7" stroke="#171717" stroke-width="1.2" />
      <rect x="197" y="74" width="22" height="28" fill={hatch} stroke="#171717" stroke-width=".6" />
    </g>
    <text x="180" y="122" text-anchor="middle" class="lbl">THE ARCHIVE OF HER</text>
    <path class="hit" d="M52 128 L180 40 L308 128 Z" />
  </Room>

  <rect x="8" y="128" width="344" height="10" fill="#E9DDC7" stroke="#171717" stroke-width="1.6" />
  <rect x="8" y="138" width="10" height="334" fill="#E9DDC7" stroke="#171717" stroke-width="1.6" />
  <rect x="342" y="138" width="10" height="334" fill="#E9DDC7" stroke="#171717" stroke-width="1.6" />

  <!-- The Wings -->
  <Room class="room" data-room="wings" {...link(rooms.wings.href, rooms.wings.name, 64, 219)}>
    <rect x="18" y="138" width="92" height="162" fill="#F0E9D9" />
    <rect class="wash" x="22" y="142" width="86" height="154" fill="#F2B6C3" filter={wash} />
    <path d="M50 212 L64 296 L106 296 L56 206" fill={hatch} opacity=".5" />
    <line x1="42" y1="296" x2="42" y2="214" stroke="#171717" stroke-width="2" />
    <path d="M33 298 L42 286 L51 298" fill="none" stroke="#171717" stroke-width="1.6" />
    <circle cx="47" cy="207" r="8" fill="#F0E9D9" stroke="#171717" stroke-width="1.4" />
    <path d="M39 207 H55 M47 199 V215" stroke="#171717" stroke-width=".8" />
    <line x1="66" y1="272" x2="98" y2="272" stroke="#171717" stroke-width="2.6" />
    <path d="M70 272 L66 298 M94 272 L98 298" stroke="#171717" stroke-width="1.8" />
    <g transform="rotate(-6 82 266)">
      <rect x="72" y="262" width="20" height="9" fill="#F0E9D9" stroke="#171717" stroke-width="1" />
      <circle cx="82" cy="266.5" r="1.8" fill="#8F1D2C" />
    </g>
    <text x="26" y="156" class="lbl">THE WINGS</text>
    <rect class="hit" x="18" y="138" width="92" height="162" />
  </Room>

  <rect x="110" y="138" width="4" height="96" fill="#E9DDC7" stroke="#171717" stroke-width="1.2" />

  <!-- The Stage: the curtain stays closed until the finale -->
  <Room class="room stage" data-room="stage" {...link(stage.href, `${stage.name}, curtain closed`, 228, 215)}>
    <rect x="114" y="138" width="228" height="162" fill="#F0E9D9" />
    <path d="M124 284 L124 170 Q124 146 148 146 L308 146 Q332 146 332 170 L332 284" fill="#E9DDC7" stroke="#171717" stroke-width="1.8" />
    <rect x="138" y="176" width="180" height="92" fill="#F2B6C3" stroke="#171717" stroke-width="1" />
    <g class="curtain-l">
      <rect x="138" y="176" width="90" height="92" fill="#641522" />
      <path d="M150 186 C148 220 152 240 149 268 M163 186 C161 220 165 240 162 268 M176 186 C174 220 178 240 175 268 M189 186 C187 220 191 240 188 268 M202 186 C200 220 204 240 201 268 M215 186 C213 220 217 240 214 268" stroke="#8F1D2C" stroke-width="1.4" fill="none" />
    </g>
    <g class="curtain-r">
      <rect x="228" y="176" width="90" height="92" fill="#641522" />
      <path d="M241 186 C239 220 243 240 240 268 M254 186 C252 220 256 240 253 268 M267 186 C265 220 269 240 266 268 M280 186 C278 220 282 240 279 268 M293 186 C291 220 295 240 292 268 M306 186 C304 220 308 240 305 268" stroke="#8F1D2C" stroke-width="1.4" fill="none" />
    </g>
    <path d="M138 176 H318 V185 Q303 195 288 185 Q273 195 258 185 Q243 195 228 185 Q213 195 198 185 Q183 195 168 185 Q153 195 138 185 Z" fill="#8F1D2C" />
    <text x="228" y="166" text-anchor="middle" class="marquee">SHANIA’S LITTLE WORLD</text>
    <line x1="228" y1="267" x2="228" y2="240" stroke="#171717" stroke-width="1.4" />
    <rect x="225.4" y="231" width="5.2" height="10" rx="2.6" fill="#171717" />
    <line x1="222" y1="267" x2="234" y2="267" stroke="#171717" stroke-width="1.6" />
    <path d="M128 268 L328 268 L336 282 L120 282 Z" fill="#E9DDC7" stroke="#171717" stroke-width="1.4" />
    <path d="M146 268 a4 4 0 0 1 8 0 M170 268 a4 4 0 0 1 8 0 M194 268 a4 4 0 0 1 8 0 M254 268 a4 4 0 0 1 8 0 M278 268 a4 4 0 0 1 8 0 M302 268 a4 4 0 0 1 8 0" fill="#F0E9D9" stroke="#171717" stroke-width=".9" />
    <text x="124" y="295" class="lbl">THE STAGE</text>
    <rect class="hit" x="114" y="138" width="228" height="162" />
  </Room>

  <rect x="8" y="300" width="344" height="10" fill="#E9DDC7" stroke="#171717" stroke-width="1.6" />

  <!-- The Box Office -->
  <Room class="room" data-room="boxoffice" {...link(rooms.boxoffice.href, rooms.boxoffice.name, 83, 390)}>
    <rect x="18" y="310" width="130" height="160" fill="#F0E9D9" />
    <rect class="wash" x="22" y="314" width="122" height="152" fill="#F2B6C3" filter={wash} />
    <rect x="50" y="334" width="66" height="13" fill="#8F1D2C" />
    <text x="83" y="343.5" text-anchor="middle" class="sign">TICKETS</text>
    <rect x="40" y="350" width="86" height="56" fill="#E9DDC7" stroke="#171717" stroke-width="1.4" />
    <path d="M56 400 V372 Q56 360 68 360 H98 Q110 360 110 372 V400 Z" fill="#F0E9D9" stroke="#171717" stroke-width="1.2" />
    <path d="M74 362 V400 M92 362 V400" stroke="#171717" stroke-width=".7" />
    <rect x="34" y="404" width="98" height="6" fill="#171717" />
    <rect x="38" y="410" width="4" height="58" fill="#171717" />
    <rect x="124" y="410" width="4" height="58" fill="#171717" />
    <g transform="rotate(-8 90 416)">
      <rect x="78" y="411" width="26" height="12" fill="#F0E9D9" stroke="#8F1D2C" stroke-width="1" />
      <line x1="96" y1="411" x2="96" y2="423" stroke="#8F1D2C" stroke-width=".8" stroke-dasharray="1.4 1.4" />
    </g>
    <text x="26" y="326" class="lbl">THE BOX OFFICE</text>
    <rect class="hit" x="18" y="310" width="130" height="160" />
  </Room>

  <rect x="148" y="310" width="4" height="92" fill="#E9DDC7" stroke="#171717" stroke-width="1.2" />

  <!-- The Dressing Room -->
  <Room class="room" data-room="dressing" {...link(rooms.dressing.href, rooms.dressing.name, 247, 390)}>
    <rect x="152" y="310" width="190" height="160" fill="#F0E9D9" />
    <rect class="wash" x="156" y="314" width="182" height="152" fill="#F2B6C3" filter={wash} />
    <rect x="196" y="340" width="104" height="72" fill="#E9DDC7" stroke="#171717" stroke-width="1.6" />
    <rect x="205" y="349" width="86" height="54" fill="#F0E9D9" stroke="#171717" stroke-width=".8" />
    <path d="M222 395 L246 357 M234 397 L254 365" stroke="#171717" stroke-width=".6" opacity=".5" />
    <g fill="#F0E9D9" stroke="#171717" stroke-width=".9">
      <circle cx="207" cy="340" r="3.4" /><circle cx="221.5" cy="340" r="3.4" /><circle cx="236" cy="340" r="3.4" />
      <circle cx="250.5" cy="340" r="3.4" /><circle cx="265" cy="340" r="3.4" /><circle cx="279.5" cy="340" r="3.4" />
      <circle cx="294" cy="340" r="3.4" /><circle cx="196" cy="356" r="3.4" /><circle cx="196" cy="376" r="3.4" />
      <circle cx="196" cy="396" r="3.4" /><circle cx="300" cy="356" r="3.4" /><circle cx="300" cy="376" r="3.4" />
      <circle cx="300" cy="396" r="3.4" />
    </g>
    <g fill="#F0E9D9" stroke="#171717" stroke-width=".8">
      <rect x="203" y="349" width="16" height="12" transform="rotate(-10 211 355)" />
      <rect x="276" y="350" width="15" height="13" transform="rotate(9 283 356)" />
      <rect x="282" y="378" width="13" height="17" transform="rotate(6 288 386)" />
      <rect x="202" y="380" width="13" height="16" transform="rotate(-7 208 388)" />
      <rect x="238" y="396" width="18" height="12" transform="rotate(3 247 402)" />
      <rect x="258" y="392" width="13" height="14" transform="rotate(-5 264 399)" />
      <rect x="220" y="393" width="12" height="13" transform="rotate(8 226 399)" />
    </g>
    <rect x="176" y="412" width="144" height="6" fill="#171717" />
    <rect x="182" y="418" width="4" height="50" fill="#171717" />
    <rect x="310" y="418" width="4" height="50" fill="#171717" />
    <rect x="304" y="400" width="7" height="12" fill="#8F1D2C" />
    <rect x="291" y="404" width="9" height="8" fill="#E9DDC7" stroke="#171717" stroke-width=".7" />
    <text x="160" y="326" class="lbl">THE DRESSING ROOM</text>
    <rect class="hit" x="152" y="310" width="190" height="160" />
  </Room>

  <rect x="0" y="470" width="360" height="6" fill="#171717" />
  <path d="M14 482 h10 M44 482 h10 M74 482 h10 M104 482 h10 M134 482 h10 M164 482 h10 M194 482 h10 M224 482 h10 M254 482 h10 M284 482 h10 M314 482 h10 M344 482 h8" stroke="#171717" stroke-width="1" opacity=".5" />
</svg>

<style>
  .house { width: 100%; height: auto; overflow: visible; }
  .lbl { font: 600 9px var(--font-ui); font-stretch: 75%; letter-spacing: .14em; fill: var(--ink); }
  .marquee { font: 650 9.6px var(--font-display); letter-spacing: .12em; fill: var(--cherry); }
  .sign { font: 600 8px var(--font-ui); font-stretch: 75%; letter-spacing: .2em; fill: var(--paper); }

  .hit { fill: transparent; stroke: none; }
  a.room { cursor: pointer; outline: none; }
  a.room:hover .hit { fill: color-mix(in srgb, var(--cherry) 6%, transparent); }
  a.room:focus-visible .hit { stroke: var(--cherry); stroke-width: 2.5; stroke-dasharray: 5 3; }
  /* Where the tour goes next: a cherry frame drawn round the room. */
  a.room.is-next .hit { stroke: var(--cherry); stroke-width: 3; fill: color-mix(in srgb, var(--cherry) 5%, transparent); }

  /* After the curtain call, the stage stays open on the drawing. */
  .curtain-l, .curtain-r { transform-box: fill-box; transition: transform .8s var(--ease-paper); }
  .curtain-l { transform-origin: left center; }
  .curtain-r { transform-origin: right center; }
  .is-open .curtain-l, .is-open .curtain-r { transform: scaleX(.12); }

  .wash {
    opacity: 0;
    transform-box: fill-box;
    transform-origin: left center;
  }
  .is-coloured .wash { opacity: .92; }
  .is-new .wash { animation: brush 1.1s var(--ease-paper) .45s both; }
  @keyframes brush {
    from { opacity: .92; transform: scaleX(0); }
    to { opacity: .92; transform: scaleX(1); }
  }
</style>
