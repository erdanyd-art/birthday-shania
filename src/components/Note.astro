---
// One birthday note taped to the Dressing Room mirror: the words in full, signed underneath.
import { Picture } from 'astro:assets';
import type { BirthdayMessage } from '../../content/types';
import { findPhoto } from '../lib/content';

interface Props {
  note: BirthdayMessage & { placeholder?: boolean };
  /** A slight lean, in degrees, so the mirror doesn't look ruled. */
  tilt: number;
}

const { note, tilt } = Astro.props;
const photo = findPhoto(note.photo);
const paragraphs = note.message.split(/\n\s*\n/).map((p) => p.trim()).filter(Boolean);
---

<article class:list={['note', { placeholder: note.placeholder }]} style={`--tilt:${tilt}deg`} aria-label={`Note from ${note.name}`}>
  <span class="tape" aria-hidden="true"></span>
  {note.placeholder && <p class="stamp">Placeholder</p>}
  {photo && note.photoAlt && (
    <figure class="snap">
      <Picture src={photo} alt={note.photoAlt} widths={[320, 480, 720]} sizes="(min-width: 45rem) 20rem, 72vw" formats={['avif', 'webp']} />
    </figure>
  )}
  <div class="words">{paragraphs.map((p) => <p>{p}</p>)}</div>
  <p class="sign">
    <span class="name">{note.name}</span>
    {note.relationship && <span class="from">{note.relationship}</span>}
  </p>
</article>

<style>
  .note {
    position: relative;
    display: grid;
    gap: .75rem;
    padding: 1.5rem 1.2rem 1.1rem;
    background: var(--edge);
    color: var(--ink);
    /* Long notes stay readable: only a slight tilt. */
    rotate: calc(var(--tilt) * .4);
    box-shadow: 0 2px 2px color-mix(in srgb, var(--ink) 10%, transparent), 0 8px 16px color-mix(in srgb, var(--ink) 14%, transparent);
  }
  .tape {
    position: absolute;
    top: -9px;
    left: 50%;
    width: 3.2rem;
    height: 1rem;
    translate: -50% 0;
    rotate: -3deg;
    background: color-mix(in srgb, var(--card) 80%, transparent);
    border: 1px solid color-mix(in srgb, var(--ink) 12%, transparent);
  }
  .words { display: grid; gap: .8rem; font-size: 1.08rem; line-height: 1.62; overflow-wrap: anywhere; }
  .sign {
    display: grid;
    justify-items: end;
    gap: .15rem;
    text-align: right;
  }
  .sign .name { font: italic 600 1.3rem/1.1 var(--font-display); color: var(--cherry); }
  .sign .name::before { content: '— '; }
  .from {
    font: 600 .72rem/1.2 var(--font-ui);
    font-stretch: 78%;
    letter-spacing: .16em;
    text-transform: uppercase;
    color: var(--ink-2);
  }
  .placeholder {
    background:
      repeating-linear-gradient(45deg, color-mix(in srgb, var(--ink) 9%, transparent) 0 1px, transparent 1px 7px),
      var(--edge);
  }
  .snap { margin: 0; background: var(--paper); padding: .45rem .45rem 1.2rem; rotate: -1deg; box-shadow: 0 6px 14px color-mix(in srgb, var(--ink) 16%, transparent); }
  .snap :global(img) { display: block; width: 100%; height: auto; }
  .stamp {
    justify-self: start;
    padding: .25rem .45rem;
    border: 2px solid var(--cherry);
    color: var(--cherry);
    font: 700 .66rem/1 var(--font-ui);
    letter-spacing: .2em;
    text-transform: uppercase;
  }
</style>
