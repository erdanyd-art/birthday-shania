---
// The stage: a pink set behind a closed curtain, a valance, footlights and an apron.
// Used for the introduction and the curtain call.
// On [data-stage]: .is-raised flies the curtain out; .is-twitch gives it a little twitch.
// Slots: "backdrop" (what's behind the curtain), "host" (Ambrose), default (the apron: his cards).

interface Props {
  /** Leave headroom above Ambrose for a banner (the curtain call). */
  banner?: boolean;
}

const { banner = false } = Astro.props;
---

<div class:list={['stage', { 'stage--banner': banner }]} data-stage>
  <div class="backdrop"><slot name="backdrop" /></div>
  <div class="curtain" aria-hidden="true"></div>
  <div class="valance" aria-hidden="true"></div>
  <div class="host" data-host><slot name="host" /></div>
  <div class="apron">
    <div class="footlights" aria-hidden="true"></div>
    <slot />
  </div>
</div>

<style>
  .stage {
    position: relative;
    overflow: hidden;
    min-height: calc(100dvh - var(--chrome-h) - env(safe-area-inset-top, 0px));
    display: grid;
    grid-template-rows: minmax(14rem, 1fr) auto;
  }

  /* Behind the curtain: her pink, lit from above. */
  .backdrop {
    position: absolute;
    inset: 0;
    background:
      radial-gradient(ellipse 70% 55% at 50% 30%, color-mix(in srgb, var(--edge) 55%, transparent), transparent 70%),
      var(--pink);
  }

  .curtain {
    position: absolute;
    inset: 0;
    z-index: 1;
    background: repeating-linear-gradient(
      90deg,
      var(--deep) 0 14px,
      color-mix(in srgb, var(--deep) 68%, var(--cherry)) 26px,
      var(--deep) 38px
    );
    transition: transform 1.6s var(--ease-paper);
  }
  .curtain::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(to bottom, transparent 55%, color-mix(in srgb, var(--ink) 38%, transparent));
  }
  .is-raised .curtain { transform: translateY(-101%); }
  .is-twitch .curtain { animation: twitch .9s ease-in-out; }
  @keyframes twitch {
    20% { transform: translateX(7px) skewX(-1.2deg); }
    45% { transform: translateX(-4px) skewX(.6deg); }
    70% { transform: translateX(2px); }
  }

  .valance {
    position: absolute;
    inset: 0 0 auto;
    height: 2.6rem;
    z-index: 3;
    background: radial-gradient(circle at 50% 0, var(--cherry) 69%, transparent 71%) 0 0 / 3.2rem 2.6rem repeat-x;
  }

  .host {
    position: relative;
    z-index: 2;
    align-self: end;
    justify-self: center;
    /* As big as the phone allows: his height has to fit between the header, the apron and any banner. */
    --headroom: 20rem;
    width: min(58vw, 17rem, max(8rem, calc((100dvh - var(--headroom)) / 1.725)));
    margin-bottom: -.3rem;
    transform-origin: 50% 100%;
    animation: enter 1.05s var(--ease-arrive) .25s both;
    transition: translate .5s var(--ease-paper);
  }
  .stage--banner .host { --headroom: 30rem; }
  .host:global(.is-here) { animation: none; }
  .host:global(.is-leaving) { translate: 115vw 0; }
  @keyframes enter {
    from { translate: -110vw 0; }
    to { translate: 0 0; }
  }

  .apron {
    position: relative;
    z-index: 4;
    display: grid;
    justify-items: center;
    gap: .9rem;
    background:
      repeating-linear-gradient(90deg, transparent 0 5.5rem, color-mix(in srgb, var(--ink) 10%, transparent) 5.5rem calc(5.5rem + 1px)),
      var(--card);
    border-top: 2px solid var(--ink);
    padding: 1.5rem var(--gutter-r) calc(1.5rem + env(safe-area-inset-bottom, 0px)) var(--gutter-l);
  }
  /* A row of footlights set into the lip of the stage, in front of the host. */
  .footlights {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    height: 8px;
    background: radial-gradient(circle at 50% 0, var(--edge) 0 3.5px, var(--ink) 4px 5px, transparent 5.5px) 1.4rem 0 / 2.8rem 8px repeat-x;
  }
  /* Ambrose's cards keep a readable width; the footlights run the full stage. */
  .apron > :global(*:not(.footlights)) { width: 100%; max-width: 34rem; }
</style>
