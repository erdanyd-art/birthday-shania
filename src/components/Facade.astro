---
// The theatre front. Same outline as HouseMap, so when it swings open
// like a doll's house the cross-section behind it lines up exactly.
import { site } from '../../content/site';

const [year, mm, day] = site.openingNight.iso.split('-');
const month = ['I', 'II', 'III', 'IV', 'V', 'VI', 'VII', 'VIII', 'IX', 'X', 'XI', 'XII'][Number(mm) - 1];
const bulbs = Array.from({ length: 15 }, (_, i) => 68 + i * 16);
const rays = Array.from({ length: 9 }, (_, i) => {
  const a = Math.PI * (i + 1) / 10;
  return { x: 180 - Math.cos(a) * 44, y: 250 - Math.sin(a) * 44 };
});
---

<svg class="facade" viewBox="0 0 360 486" aria-hidden="true">
  <line x1="180" y1="16" x2="180" y2="2" stroke="#171717" stroke-width="1.4" />
  <path d="M180 2 L196 6 L180 10 Z" fill="#8F1D2C" />

  <!-- pediment -->
  <path d="M8 132 L180 16 L352 132 Z" fill="#E9DDC7" stroke="#171717" stroke-width="2" />
  <path d="M42 124 L180 32 L318 124 Z" fill="#F0E9D9" stroke="#171717" stroke-width="1.2" />
  <circle cx="180" cy="92" r="20" fill="#E9DDC7" stroke="#171717" stroke-width="1.4" />
  <circle cx="180" cy="92" r="14" fill="#F0E9D9" stroke="#171717" stroke-width=".9" />
  <path d="M166 92 H194 M180 78 V106" stroke="#171717" stroke-width=".9" />
  <rect x="8" y="128" width="344" height="10" fill="#E9DDC7" stroke="#171717" stroke-width="1.6" />

  <!-- wall and pilasters -->
  <rect x="18" y="138" width="324" height="332" fill="#F0E9D9" />
  <rect x="8" y="138" width="10" height="334" fill="#E9DDC7" stroke="#171717" stroke-width="1.6" />
  <rect x="342" y="138" width="10" height="334" fill="#E9DDC7" stroke="#171717" stroke-width="1.6" />
  <rect x="22" y="146" width="18" height="324" fill="#E9DDC7" stroke="#171717" stroke-width="1.1" />
  <rect x="320" y="146" width="18" height="324" fill="#E9DDC7" stroke="#171717" stroke-width="1.1" />
  <rect x="18" y="138" width="26" height="8" fill="#E9DDC7" stroke="#171717" stroke-width="1.1" />
  <rect x="316" y="138" width="26" height="8" fill="#E9DDC7" stroke="#171717" stroke-width="1.1" />

  <!-- marquee -->
  <rect x="58" y="150" width="244" height="40" fill="#8F1D2C" />
  <rect x="63" y="155" width="234" height="30" fill="none" stroke="#F0E9D9" stroke-width=".8" />
  <text x="180" y="175.5" text-anchor="middle" class="marquee">SHANIA’S LITTLE WORLD</text>
  <g fill="#F0E9D9" stroke="#171717" stroke-width=".6">
    {bulbs.map((x) => <circle cx={x} cy="150" r="2.4" />)}
    {bulbs.map((x) => <circle cx={x} cy="190" r="2.4" />)}
  </g>

  <!-- posters -->
  <g transform="rotate(-1.5 76 266)">
    <rect x="46" y="214" width="60" height="104" fill="#E9DDC7" stroke="#171717" stroke-width="1.2" />
    <rect x="50.5" y="218.5" width="51" height="95" fill="#F0E9D9" stroke="#8F1D2C" stroke-width=".8" />
    <text x="76" y="236" text-anchor="middle" class="p-label">TONIGHT</text>
    <line x1="60" y1="242" x2="92" y2="242" stroke="#8F1D2C" stroke-width=".6" />
    <text x="76" y="258" text-anchor="middle" class="p-italic">A small show</text>
    <text x="76" y="268" text-anchor="middle" class="p-italic">in five rooms</text>
    <path d="M76 280 l2.2 4.6 5 .5 -3.8 3.3 1.2 4.9 -4.6 -2.6 -4.6 2.6 1.2 -4.9 -3.8 -3.3 5 -.5 Z" fill="#8F1D2C" />
    <text x="76" y="306" text-anchor="middle" class="p-small">ALL WELCOME</text>
  </g>
  <g transform="rotate(1.2 284 266)">
    <rect x="254" y="214" width="60" height="104" fill="#E9DDC7" stroke="#171717" stroke-width="1.2" />
    <rect x="258.5" y="218.5" width="51" height="95" fill="#F0E9D9" stroke="#8F1D2C" stroke-width=".8" />
    <text x="284" y="236" text-anchor="middle" class="p-label">OPENING</text>
    <text x="284" y="246" text-anchor="middle" class="p-label">NIGHT</text>
    <text x="284" y="276" text-anchor="middle" class="p-date">{day}·{month}</text>
    <line x1="268" y1="284" x2="300" y2="284" stroke="#8F1D2C" stroke-width=".6" />
    <text x="284" y="298" text-anchor="middle" class="p-small">{year}</text>
  </g>

  <!-- doors -->
  <path d="M132 250 A48 48 0 0 1 228 250 Z" fill="#E9DDC7" stroke="#171717" stroke-width="1.4" />
  <g stroke="#171717" stroke-width=".7">
    {rays.map((r) => <line x1="180" y1="250" x2={r.x} y2={r.y} />)}
  </g>
  <path d="M126 440 V250 A54 54 0 0 1 234 250 V440" fill="none" stroke="#171717" stroke-width="1.6" />
  <rect x="132" y="250" width="96" height="190" fill="#641522" stroke="#171717" stroke-width="1.6" />
  <line x1="180" y1="250" x2="180" y2="440" stroke="#171717" stroke-width="1.4" />
  <g fill="none" stroke="#8F1D2C" stroke-width="1.1">
    <rect x="140" y="262" width="32" height="72" />
    <rect x="188" y="262" width="32" height="72" />
    <rect x="140" y="348" width="32" height="80" />
    <rect x="188" y="348" width="32" height="80" />
  </g>
  <circle cx="174" cy="342" r="2.4" fill="#E9DDC7" stroke="#171717" stroke-width=".6" />
  <circle cx="186" cy="342" r="2.4" fill="#E9DDC7" stroke="#171717" stroke-width=".6" />

  <!-- lamps -->
  <g stroke="#171717" stroke-width="1.1">
    <line x1="126" y1="268" x2="120" y2="268" />
    <path d="M110 258 H122 L119 282 H113 Z" fill="#F0E9D9" />
    <path d="M108 258 H124 L116 250 Z" fill="#171717" />
    <line x1="234" y1="268" x2="240" y2="268" />
    <path d="M238 258 H250 L247 282 H241 Z" fill="#F0E9D9" />
    <path d="M236 258 H252 L244 250 Z" fill="#171717" />
  </g>

  <!-- steps -->
  <g fill="#E9DDC7" stroke="#171717" stroke-width="1.2">
    <rect x="116" y="440" width="128" height="10" />
    <rect x="104" y="450" width="152" height="10" />
    <rect x="92" y="460" width="176" height="10" />
  </g>

  <rect x="0" y="470" width="360" height="6" fill="#171717" />
  <path d="M14 482 h10 M44 482 h10 M74 482 h10 M104 482 h10 M134 482 h10 M164 482 h10 M194 482 h10 M224 482 h10 M254 482 h10 M284 482 h10 M314 482 h10 M344 482 h8" stroke="#171717" stroke-width="1" opacity=".5" />
</svg>

<style>
  .facade { width: 100%; height: auto; overflow: visible; }
  .marquee { font: 650 14px var(--font-display); letter-spacing: .1em; fill: var(--paper); }
  .p-label { font: 600 7.6px var(--font-ui); font-stretch: 75%; letter-spacing: .22em; fill: var(--cherry); }
  .p-italic { font: italic 500 7.2px var(--font-display); fill: var(--ink); }
  .p-small { font: 600 6px var(--font-ui); font-stretch: 78%; letter-spacing: .2em; fill: var(--ink); }
  .p-date { font: 650 18px var(--font-display); fill: var(--ink); }
</style>
