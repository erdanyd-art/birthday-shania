---
// Temporary page for rooms that arrive in Stage 5. Never part of the launch.
import Base from '../layouts/Base.astro';

interface Props {
  scene: string;
  name: string;
}

const { scene, name } = Astro.props;
---

<Base title={name}>
  <div class="page unbuilt">
    <p class="kicker">{scene}</p>
    <h1 class="title">{name}</h1>
    <p class="note"><span class="stamp">Not built yet</span> This room opens in the next build.</p>
    <a class="btn ghost" href="/house">Back to the house</a>
  </div>
</Base>

<style>
  .unbuilt { display: grid; gap: 1.25rem; justify-items: start; padding-top: clamp(3rem, 12vw, 7rem); }
  .note { font-size: 1.15rem; color: var(--ink-2); }
  .stamp {
    display: inline-block;
    margin-right: .5rem;
    padding: .25rem .45rem;
    border: 2px solid var(--cherry);
    color: var(--cherry);
    font: 700 .66rem/1 var(--font-ui);
    letter-spacing: .2em;
    text-transform: uppercase;
    vertical-align: .15em;
  }
</style>
