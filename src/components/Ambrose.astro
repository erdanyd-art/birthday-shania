---
// The host: a cut-paper silhouette on a card tab, pushed on from the wings on a wire.
// One pose for now ("welcome"); bow, point and hat-to-chest arrive in Stage 5.
import { site } from '../../content/site';

interface Props {
  class?: string;
}

const { class: className } = Astro.props;
const uid = `amb-${Math.random().toString(36).slice(2, 8)}`;
---

<svg
  class:list={['ambrose', className]}
  viewBox="0 14 240 414"
  role="img"
  aria-label={`${site.host}, the host: a black paper silhouette in a top hat and tailcoat with a cherry bow tie, one arm raised in welcome.`}
>
  <defs>
    <filter id={`${uid}-lift`} x="-20%" y="-10%" width="140%" height="130%">
      <feDropShadow dx="3" dy="5" stdDeviation="3" flood-color="#171717" flood-opacity=".35" />
    </filter>
    <g id={`${uid}-fig`}>
      <path d="M100 93 L97 34 C112 28 130 26 146 27 L145 87 Z" />
      <path d="M88 96 C110 86 136 82 158 84 L158 90 C136 88 112 92 90 102 Z" />
      <path d="M100 94 C92 106 92 128 102 138 L106 158 L130 158 C131 145 132 141 136 139 C142 137 146 134 147 130 L145 127 L148 124 L145 121 L148 118 C150 117 156 116 158 114 C156 110 150 104 147 100 C147 96 146 93 145 90 Z" />
      <path d="M100 150 C92 156 88 168 88 182 C88 204 94 222 102 234 L124 234 C134 222 146 206 150 186 C152 170 146 158 134 150 Z" />
      <path d="M100 222 C92 246 82 276 72 306 L80 310 C92 290 104 266 112 240 Z" />
      <path d="M106 226 C100 254 92 286 88 314 L97 316 C103 292 111 266 118 242 Z" />
      <path d="M100 230 L126 230 C130 240 132 250 130 260 L102 262 C98 252 98 240 100 230 Z" />
      <path d="M102 256 L120 258 C118 290 114 330 112 396 L100 396 C99 350 98 300 102 256 Z" />
      <path d="M116 256 L132 254 C140 276 152 300 160 322 C162 346 166 370 170 396 L157 397 C153 372 147 350 143 330 C132 308 122 284 116 256 Z" />
      <path d="M96 393 L113 393 C122 397 127 402 128 408 L95 408 Z" />
      <path d="M155 393 L171 393 C181 397 187 402 188 408 L154 408 Z" />
      <path d="M124 158 C136 150 148 142 158 136 L189 104 L199 113 L169 150 C156 162 142 172 130 177 Z" />
      <path d="M188 105 C192 94 200 86 210 82 C216 80 220 82 219 86 C214 90 210 94 208 98 L220 94 C223 94 224 98 221 99 L206 106 C204 110 201 113 199 113 Z" />
      <path d="M136 232 C142 227 152 228 154 235 C154 242 146 246 138 243 Z" />
      <path d="M148.2 232.3 L151.8 231.7 L181.8 405.7 L178.2 406.3 Z" />
      <circle cx="150" cy="230" r="5" />
      <rect x="64" y="408" width="132" height="12" />
    </g>
  </defs>
  <g filter={`url(#${uid}-lift)`}>
    <use href={`#${uid}-fig`} fill="#F7F2E6" stroke="#F7F2E6" stroke-width="10" stroke-linejoin="round" />
    <use href={`#${uid}-fig`} fill="#171717" />
    <path d="M134 152 C144 160 148 174 147 190 C145 206 138 220 128 232 L124 232 C132 220 139 206 141 190 C142 175 138 162 130 154 Z" fill="#F0E9D9" />
    <path d="M184.4 108.8 L189 104 L199 113 L194.5 118.6 Z" fill="#F0E9D9" />
    <path d="M128 150 L142 143 L140 151 L143 159 Z" fill="#8F1D2C" />
    <path d="M98.6 80 L145.3 74 L145.1 85 L99 91 Z" fill="#8F1D2C" />
  </g>
  <line x1="-400" y1="414" x2="64" y2="414" stroke="#F7F2E6" stroke-width="1.6" />
</svg>

<style>
  .ambrose {
    overflow: visible;
    transform-origin: 50% 100%;
  }
</style>
