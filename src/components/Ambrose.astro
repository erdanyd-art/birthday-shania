---
// The host: a cut-paper silhouette on a card tab, pushed on from the wings on a wire.
// Four poses, swapped like toy-theatre figures by setting data-pose on the <svg>:
// welcome (arm raised), point, chest (hat held to his chest) and bow (upper body tips forward).
import { site } from '../../content/site';
import type { Pose } from '../../content/types';

interface Props {
  class?: string;
  pose?: Pose;
  /** The wire he's pushed on with. Shown on the stage; hidden when he stands in a room. */
  wire?: boolean;
  /** Hide him from screen readers when his name is already written next to him. */
  decorative?: boolean;
}

const { class: className, pose = 'welcome', wire = true, decorative = false } = Astro.props;
const uid = `amb-${Math.random().toString(36).slice(2, 8)}`;

type Part = { d: string; only?: string };

// Legs, tails, shoes, cane and card tab: these never move.
const lower: Part[] = [
  { d: 'M100 222 C92 246 82 276 72 306 L80 310 C92 290 104 266 112 240 Z' },
  { d: 'M106 226 C100 254 92 286 88 314 L97 316 C103 292 111 266 118 242 Z' },
  { d: 'M100 230 L126 230 C130 240 132 250 130 260 L102 262 C98 252 98 240 100 230 Z' },
  { d: 'M102 256 L120 258 C118 290 114 330 112 396 L100 396 C99 350 98 300 102 256 Z' },
  { d: 'M116 256 L132 254 C140 276 152 300 160 322 C162 346 166 370 170 396 L157 397 C153 372 147 350 143 330 C132 308 122 284 116 256 Z' },
  { d: 'M96 393 L113 393 C122 397 127 402 128 408 L95 408 Z' },
  { d: 'M148.2 232.3 L151.8 231.7 L181.8 405.7 L178.2 406.3 Z' },
  { d: 'M136 232 C142 227 152 228 154 235 C154 242 146 246 138 243 Z' },
  { d: 'M64 408 H196 V420 H64 Z' },
];
// The shoe he asks you not to look at.
const shoe = 'M155 393 L171 393 C181 397 187 402 188 408 L154 408 Z';

// Torso, head, hat and arms: these tip forward together in the bow.
const upper: Part[] = [
  { d: 'M100 150 C92 156 88 168 88 182 C88 204 94 222 102 234 L124 234 C134 222 146 206 150 186 C152 170 146 158 134 150 Z' },
  { d: 'M100 94 C92 106 92 128 102 138 L106 158 L130 158 C131 145 132 141 136 139 C142 137 146 134 147 130 L145 127 L148 124 L145 121 L148 118 C150 117 156 116 158 114 C156 110 150 104 147 100 C147 96 146 93 145 90 Z' },
  { d: 'M100 93 L97 34 C112 28 130 26 146 27 L145 87 Z', only: 'hat-on' },
  { d: 'M88 96 C110 86 136 82 158 84 L158 90 C136 88 112 92 90 102 Z', only: 'hat-on' },
  { d: 'M98 98 C96 80 112 70 130 72 C142 74 149 84 146 96 Z', only: 'hat-off' },
  // welcome: arm raised forward, palm up
  { d: 'M124 158 C136 150 148 142 158 136 L189 104 L199 113 L169 150 C156 162 142 172 130 177 Z', only: 'arm-welcome' },
  { d: 'M188 105 C192 94 200 86 210 82 C216 80 220 82 219 86 C214 90 210 94 208 98 L220 94 C223 94 224 98 221 99 L206 106 C204 110 201 113 199 113 Z', only: 'arm-welcome' },
  // point: arm straight out, one finger
  { d: 'M122 156 C142 154 168 156 192 158 L193 172 C168 172 144 175 128 179 Z', only: 'arm-point' },
  { d: 'M190 157 C197 154 204 157 206 161 L222 161 C225 161 225 166 222 166 L206 167 C204 172 198 175 191 173 Z', only: 'arm-point' },
  // chest: hat off, held to his chest
  { d: 'M122 158 C130 166 136 182 138 198 C146 196 152 192 156 186 L162 192 C156 202 146 210 134 212 C128 196 124 180 116 168 Z', only: 'arm-chest' },
  { d: 'M140 164 L170 166 L168 214 L138 212 Z', only: 'arm-chest' },
  { d: 'M133 154 L141 155 L139 224 L131 223 Z', only: 'arm-chest' },
  // bow: arm hanging forward as he tips
  { d: 'M120 156 C128 162 134 178 136 198 L140 226 L130 228 C126 208 122 188 116 170 Z', only: 'arm-bow' },
  { d: 'M128 226 C132 222 140 222 142 228 C142 236 136 240 130 236 Z', only: 'arm-bow' },
];
---

<svg
  class:list={['ambrose', className]}
  viewBox="0 14 240 414"
  data-ambrose
  data-pose={pose}
  role={decorative ? undefined : 'img'}
  aria-hidden={decorative ? 'true' : undefined}
  aria-label={decorative ? undefined : `${site.host}, the host: a black paper silhouette in a top hat and tailcoat with a cherry bow tie.`}
>
  <defs>
    <filter id={`${uid}-lift`} x="-20%" y="-10%" width="140%" height="130%">
      <feDropShadow dx="3" dy="5" stdDeviation="3" flood-color="#171717" flood-opacity=".35" />
    </filter>
  </defs>
  <g filter={`url(#${uid}-lift)`}>
    {['edge', 'ink'].map((layer) => (
      <g
        class={layer}
        fill={layer === 'edge' ? '#F7F2E6' : '#171717'}
        stroke={layer === 'edge' ? '#F7F2E6' : undefined}
        stroke-width={layer === 'edge' ? 10 : undefined}
        stroke-linejoin="round"
      >
        <g class="lower">
          {lower.map((p) => <path d={p.d} />)}
          <circle cx="150" cy="230" r="5" />
          <path class="shoe" d={shoe} />
        </g>
        <g class="upper">
          {upper.map((p) => <path d={p.d} class={p.only} />)}
        </g>
      </g>
    ))}
    <g class="upper">
      <path d="M134 152 C144 160 148 174 147 190 C145 206 138 220 128 232 L124 232 C132 220 139 206 141 190 C142 175 138 162 130 154 Z" fill="#F0E9D9" />
      <path d="M128 150 L142 143 L140 151 L143 159 Z" fill="#8F1D2C" />
      <path class="hat-on" d="M98.6 80 L145.3 74 L145.1 85 L99 91 Z" fill="#8F1D2C" />
      <path class="arm-welcome" d="M184.4 108.8 L189 104 L199 113 L194.5 118.6 Z" fill="#F0E9D9" />
      <path class="arm-point" d="M186 157.6 L192 157.8 L193 172.2 L187 172.4 Z" fill="#F0E9D9" />
      <path class="arm-chest" d="M140 164 L170 166 L168 214 L138 212 Z M133 154 L141 155 L139 224 L131 223 Z" fill="none" stroke="#F0E9D9" stroke-width="1.4" />
      <path class="arm-chest" d="M145 164.4 L151 164.8 L149.4 212.6 L143.4 212.4 Z" fill="#8F1D2C" />
      <path class="arm-chest" d="M150 194 L157 191 L160 197 L153 200 Z" fill="#F0E9D9" />
      <circle class="carnation" cx="139" cy="171" r="5" fill="#F2B6C3" stroke="#171717" stroke-width="1" />
    </g>
  </g>
  {wire && <line x1="-400" y1="414" x2="64" y2="414" stroke="#F7F2E6" stroke-width="1.6" />}
</svg>

<style>
  .ambrose {
    overflow: visible;
    transform-origin: 50% 100%;
  }

  /* Only the parts of the current pose are shown. */
  .hat-off, .arm-welcome, .arm-point, .arm-chest, .arm-bow, .carnation { display: none; }
  .ambrose[data-pose='welcome'] .arm-welcome,
  .ambrose[data-pose='point'] .arm-point,
  .ambrose[data-pose='chest'] .arm-chest,
  .ambrose[data-pose='bow'] .arm-bow,
  .ambrose[data-pose='chest'] .hat-off { display: inline; }
  .ambrose[data-pose='chest'] .hat-on { display: none; }
  .ambrose.has-carnation .carnation { display: inline; }

  .upper {
    transform-box: view-box;
    transform-origin: 112px 236px; /* his hips */
    transition: transform .45s cubic-bezier(.65, 0, .35, 1);
  }
  .ambrose[data-pose='bow'] .upper { transform: rotate(28deg); }

  .shoe { transform-box: view-box; transform-origin: 156px 407px; }
  .ambrose.is-shoe .shoe { animation: shoe .7s ease-in-out; }
  @keyframes shoe {
    25% { transform: rotate(-14deg); }
    55% { transform: rotate(8deg); }
    80% { transform: rotate(-4deg); }
  }
</style>
