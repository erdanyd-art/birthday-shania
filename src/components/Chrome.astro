---
import SoundToggle from './SoundToggle.astro';
import { site } from '../../content/site';

interface Props {
  current?: 'house';
}

const { current } = Astro.props;
---

<header class="chrome">
  <p class="wordmark">{site.title}</p>
  <div class="tools">
    <SoundToggle />
    <a class="house-link" href="/house" aria-current={current === 'house' ? 'page' : undefined}>
      <svg viewBox="0 0 20 20" width="18" height="18" aria-hidden="true">
        <path d="M2 9 L10 2.5 L18 9" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round" />
        <path d="M4.5 8 V17.5 H15.5 V8" fill="none" stroke="currentColor" stroke-width="1.6" />
        <path d="M8.5 17.5 V12.5 H11.5 V17.5" fill="none" stroke="currentColor" stroke-width="1.4" />
      </svg>
      <span>Map</span>
    </a>
  </div>
</header>

<style>
  .chrome {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    min-height: var(--chrome-h);
    padding-top: env(safe-area-inset-top, 0px);
    /* Line up with the 72rem page column on wide screens. */
    padding-left: max(var(--gutter-l), calc((100% - 72rem) / 2 + 16px));
    padding-right: max(var(--gutter-r), calc((100% - 72rem) / 2 + 16px));
    border-bottom: 1px solid var(--rule);
  }
  :global(html[data-tone='night']) .chrome {
    background: var(--deep);
    border-bottom-color: color-mix(in srgb, var(--paper) 18%, transparent);
  }
  .wordmark {
    font: 600 1.05rem/1.1 var(--font-display);
    letter-spacing: .01em;
  }
  .tools { display: flex; align-items: center; gap: .6rem; color: var(--ink-2); }
  :global(html[data-tone='night']) .tools { color: var(--paper); }
  .house-link {
    display: inline-flex;
    align-items: center;
    gap: .45rem;
    min-height: 44px;
    padding-inline: .25rem;
    font: 600 .74rem/1 var(--font-ui);
    font-stretch: 78%;
    letter-spacing: .18em;
    text-transform: uppercase;
    text-decoration: none;
    color: var(--cherry);
  }
  :global(html[data-tone='night']) .house-link { color: var(--pink); }
  /* The map is the end of the show: it appears once the curtain has gone up. */
  :global(html[data-js]:not([data-free])) .house-link { display: none; }
  .house-link:hover span,
  .house-link[aria-current='page'] span {
    text-decoration: underline;
    text-underline-offset: .3em;
    text-decoration-thickness: 1.5px;
  }
</style>
