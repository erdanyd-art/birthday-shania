---
// Door 3: light the lamp. Six cards face down, three pairs of Ambrose's things.
// Find the pairs and the work light in the Wings comes on.
const symbols = {
  hat: 'M22 40 L21 16 C27 14 37 14 43 15 L42 40 Z M14 44 C24 39 40 38 50 41 L50 45 C40 42 24 43 15 48 Z',
  tie: 'M32 32 L14 22 V42 Z M32 32 L50 22 V42 Z M28 28 H36 V36 H28 Z',
  ticket: 'M12 20 H52 V28 C48 28 48 36 52 36 V44 H12 V36 C16 36 16 28 12 28 Z M40 20 V44',
} as const;
---

<div class="memory" data-game="lamp" data-symbols={JSON.stringify(symbols)}>
  <svg class="lamp" viewBox="0 0 80 90" aria-hidden="true">
    <path class="beam" d="M48 20 L80 90 H20 Z" />
    <line x1="22" y1="88" x2="22" y2="26" stroke="currentColor" stroke-width="3" />
    <path d="M22 26 L40 18" stroke="currentColor" stroke-width="3" />
    <circle class="bulb" cx="46" cy="16" r="9" stroke="currentColor" stroke-width="2" />
  </svg>
  <ul class="cards">
    {Array.from({ length: 6 }, (_, i) => (
      <li>
        <button type="button" class="card" data-card={i} aria-label={`Card ${i + 1}, face down`}>
          <span class="inner">
            <span class="back" aria-hidden="true"></span>
            <span class="face" aria-hidden="true"><svg viewBox="0 0 64 64"><path d="" fill="#171717" /></svg></span>
          </span>
        </button>
      </li>
    ))}
  </ul>
  <p class="hint" data-hint aria-live="polite">Find the three pairs</p>
</div>

<script>
  import { onPage } from '../../lib/page';
  import { play } from '../../lib/sound';

  const names: Record<string, string> = { hat: 'top hat', tie: 'bow tie', ticket: 'ticket' };

  onPage((signal) => {
    const root = document.querySelector<HTMLElement>('[data-game="lamp"]');
    if (!root) return;
    const symbols = JSON.parse(root.dataset.symbols ?? '{}') as Record<string, string>;
    const deck = Object.keys(symbols).flatMap((s) => [s, s]).sort(() => Math.random() - 0.5);
    const cards = [...root.querySelectorAll<HTMLButtonElement>('[data-card]')];
    const hint = root.querySelector<HTMLElement>('[data-hint]')!;
    cards.forEach((card, i) => card.querySelector('path')!.setAttribute('d', symbols[deck[i]!]!));

    let open: number[] = [];
    let matched = 0;
    let misses = 0;
    let busy = false;

    const flip = (i: number, up: boolean) => {
      cards[i]!.classList.toggle('up', up);
      cards[i]!.setAttribute('aria-label', up ? `Card ${i + 1}: ${names[deck[i]!]}` : `Card ${i + 1}, face down`);
    };

    cards.forEach((card, i) => {
      card.addEventListener('click', () => {
        if (busy || card.classList.contains('up')) return;
        flip(i, true);
        play('paper');
        open.push(i);
        if (open.length < 2) return;
        const [a, b] = open as [number, number];
        open = [];
        if (deck[a] === deck[b]) {
          matched += 1;
          cards[a]!.classList.add('matched');
          cards[b]!.classList.add('matched');
          hint.textContent = matched === 3 ? 'Let there be light.' : `A pair! ${3 - matched} to go.`;
          if (matched === 3) {
            root.classList.add('lit');
            root.dispatchEvent(new CustomEvent('game:won', { bubbles: true }));
          }
          return;
        }
        misses += 1;
        hint.textContent = 'Not a pair. Try again.';
        if (misses === 4) root.dispatchEvent(new CustomEvent('game:struggle', { bubbles: true }));
        busy = true;
        window.setTimeout(() => { flip(a, false); flip(b, false); busy = false; }, 750);
      }, { signal });
    });
  });
</script>

<style>
  .memory { display: grid; gap: 1rem; justify-items: center; width: 100%; }
  .lamp { width: 4.5rem; height: auto; color: var(--paper); }
  .beam { fill: var(--edge); opacity: .04; transition: opacity .8s ease; }
  .bulb { fill: var(--ink); transition: fill .4s ease; }
  .memory:global(.lit) .beam { opacity: .28; }
  .memory:global(.lit) .bulb { fill: var(--edge); }
  .cards { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(3, minmax(0, 6.5rem)); gap: .7rem; }
  .card { width: 100%; aspect-ratio: 3 / 4; padding: 0; border: 0; background: none; cursor: pointer; perspective: 600px; }
  .inner { position: relative; display: block; width: 100%; height: 100%; transition: transform .4s var(--ease-paper); transform-style: preserve-3d; }
  .card:global(.up) .inner { transform: rotateY(180deg); }
  .back, .face { position: absolute; inset: 0; backface-visibility: hidden; border: 1.5px solid var(--ink); }
  .back { background: repeating-linear-gradient(45deg, var(--cherry) 0 6px, var(--deep) 6px 12px); outline: 2px solid var(--edge); outline-offset: -6px; }
  .face { display: grid; place-items: center; background: var(--edge); transform: rotateY(180deg); }
  .face svg { width: 70%; height: auto; }
  .card:global(.matched) .face { background: var(--pink); }
  .hint { font: italic 480 1.1rem/1.3 var(--font-display); }
</style>
