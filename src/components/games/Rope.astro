---
// Door 4: pull the rope. A ring closes in on the circle, again and again; tap Pull as it
// meets the circle. Four good pulls and the curtain is ready. Generous timing, no penalty.
---

<div class="rope" data-game="rope">
  <div class="target" aria-hidden="true">
    <span class="ring" data-ring></span>
    <span class="circle"></span>
  </div>
  <div class="pulls" aria-hidden="true">{[0, 1, 2, 3].map(() => <span class="pull" />)}</div>
  <button type="button" class="btn pull-btn" data-pull>Pull</button>
  <p class="hint" data-hint aria-live="polite">Tap Pull when the ring meets the circle</p>
</div>

<script>
  import { onPage } from '../../lib/page';
  import { reducedMotion } from '../../lib/motion';
  import { play } from '../../lib/sound';

  onPage((signal) => {
    const root = document.querySelector<HTMLElement>('[data-game="rope"]');
    if (!root) return;
    const ring = root.querySelector<HTMLElement>('[data-ring]')!;
    const hint = root.querySelector<HTMLElement>('[data-hint]')!;
    const pulls = [...root.querySelectorAll<HTMLElement>('.pull')];
    // Slower, with a wider window, for anyone who prefers less motion.
    const period = reducedMotion() ? 2200 : 1500;
    const window_ = reducedMotion() ? 0.3 : 0.2;
    const start = performance.now();
    let hits = 0;
    let misses = 0;
    let frame = 0;

    // The ring shrinks from 2.6× to 1× the circle's size, then starts again.
    const scaleAt = (t: number) => 2.6 - 1.6 * (((t - start) % period) / period);
    const draw = (t: number) => {
      ring.style.scale = String(scaleAt(t));
      frame = requestAnimationFrame(draw);
    };
    frame = requestAnimationFrame(draw);
    signal.addEventListener('abort', () => cancelAnimationFrame(frame));

    root.querySelector('[data-pull]')!.addEventListener('click', () => {
      if (hits >= 4) return;
      if (scaleAt(performance.now()) - 1 <= window_) {
        pulls[hits]!.classList.add('done');
        hits += 1;
        play('paper');
        hint.textContent = hits === 4 ? 'Ready. The curtain can rise.' : ['Nice.', 'Again.', 'One more.'][hits - 1]!;
        if (hits === 4) {
          cancelAnimationFrame(frame);
          ring.style.scale = '1';
          root.classList.add('ready');
          root.dispatchEvent(new CustomEvent('game:won', { bubbles: true }));
        }
        return;
      }
      misses += 1;
      hint.textContent = 'Too early. Wait for the ring to meet the circle.';
      if (misses === 4) root.dispatchEvent(new CustomEvent('game:struggle', { bubbles: true }));
    }, { signal });
  });
</script>

<style>
  .rope { display: grid; gap: 1.1rem; justify-items: center; width: 100%; }
  .target { position: relative; width: 9rem; aspect-ratio: 1; display: grid; place-items: center; }
  .circle, .ring { position: absolute; width: 4.5rem; aspect-ratio: 1; border-radius: 50%; }
  .circle { background: var(--pink); border: 2px solid var(--ink); }
  .ring { border: 3px solid var(--paper); box-shadow: 0 0 0 1px var(--ink); }
  .rope:global(.ready) .circle { background: var(--cherry); }
  .pulls { display: flex; gap: .6rem; }
  .pull { width: 1.1rem; height: 1.1rem; border-radius: 50%; border: 1.5px dashed var(--paper); }
  .pull:global(.done) { border-style: solid; background: var(--pink); }
  .pull-btn { min-width: 10rem; font-size: 1.05rem; }
  .hint { text-align: center; font: italic 480 1.1rem/1.3 var(--font-display); }
</style>
