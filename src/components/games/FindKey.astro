---
// Door 2: find the key. Ambrose dropped the Dressing Room key somewhere backstage.
// Tap a prop to lift it. After a few misses, the right one starts to wiggle.
const props = [
  { name: 'Trunk', d: 'M10 26 H54 V52 H10 Z M10 34 H54 M22 26 V52 M42 26 V52 M28 20 H36 V26 H28 Z' },
  { name: 'Hat box', d: 'M12 22 C12 14 52 14 52 22 V48 C52 56 12 56 12 48 Z M12 22 C12 30 52 30 52 22 M24 26 V54 M40 26 V54' },
  { name: 'Flower pot', d: 'M20 34 H44 L40 56 H24 Z M32 34 V20 M32 20 C26 12 22 20 32 20 C42 20 38 12 32 20 M26 28 C22 24 28 22 32 28' },
  { name: 'Old boot', d: 'M24 10 H38 V38 C46 40 54 44 54 52 V56 H18 V46 C22 44 24 40 24 34 Z M18 52 H54' },
  { name: 'Coat', d: 'M32 8 C36 8 36 13 32 13 M32 13 L18 22 V56 H46 V22 Z M32 13 V56 M26 30 H30 M26 40 H30' },
  { name: 'Spotlight', d: 'M18 20 L40 14 L46 36 L24 42 Z M32 40 L30 56 M22 56 H40 M46 26 L56 24' },
];
---

<div class="find" data-game="key">
  <ul class="props">
    {props.map((p, i) => (
      <li>
        <button type="button" class="prop" data-prop={i} aria-label={`Look under the ${p.name.toLowerCase()}`}>
          <span class="under" aria-hidden="true">
            <svg class="key" viewBox="0 0 64 64"><circle cx="20" cy="32" r="9" fill="none" stroke="#8F1D2C" stroke-width="4" /><path d="M29 32 H54 M46 32 V40 M52 32 V38" fill="none" stroke="#8F1D2C" stroke-width="4" stroke-linecap="round" /></svg>
            <span class="dust">Just dust</span>
          </span>
          <svg class="thing" viewBox="0 0 64 64" aria-hidden="true">
            <path d={p.d} fill="#F7F2E6" stroke="#171717" stroke-width="2" stroke-linejoin="round" />
          </svg>
          <span class="name">{p.name}</span>
        </button>
      </li>
    ))}
  </ul>
  <p class="hint" data-hint aria-live="polite">Tap a prop to look underneath</p>
</div>

<script>
  import { onPage } from '../../lib/page';
  import { play } from '../../lib/sound';

  const misses = ['Not there.', 'Just dust.', 'Nope. Keep looking.', 'Warmer… no, colder.'];

  onPage((signal) => {
    const root = document.querySelector<HTMLElement>('[data-game="key"]');
    if (!root) return;
    const buttons = [...root.querySelectorAll<HTMLButtonElement>('[data-prop]')];
    const hint = root.querySelector<HTMLElement>('[data-hint]')!;
    const answer = Math.floor(Math.random() * buttons.length);
    let tries = 0;
    let found = false;

    buttons.forEach((button, i) => {
      button.addEventListener('click', () => {
        if (found || button.classList.contains('lifted')) return;
        button.classList.add('lifted');
        play('paper');
        if (i === answer) {
          found = true;
          button.classList.add('has-key');
          hint.textContent = 'The key! Well spotted.';
          root.dispatchEvent(new CustomEvent('game:won', { bubbles: true }));
          return;
        }
        hint.textContent = misses[tries % misses.length]!;
        tries += 1;
        if (tries === 3) {
          buttons[answer]!.classList.add('wiggle');
          root.dispatchEvent(new CustomEvent('game:struggle', { bubbles: true }));
        }
      }, { signal });
    });
  });
</script>

<style>
  .find { display: grid; gap: 1rem; width: 100%; }
  .props { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: .7rem; }
  .prop {
    position: relative;
    display: grid;
    justify-items: center;
    gap: .2rem;
    width: 100%;
    min-height: 7rem;
    padding: .6rem .3rem .5rem;
    border: 1px solid var(--rule);
    background: var(--card);
    color: var(--ink);
    cursor: pointer;
    overflow: hidden;
  }
  .thing { width: 3.6rem; height: 3.6rem; position: relative; z-index: 1; transition: translate .35s var(--ease-arrive), rotate .35s var(--ease-arrive); }
  .under { position: absolute; inset: .6rem 0 auto; display: grid; justify-items: center; opacity: 0; transition: opacity .25s ease .15s; }
  .key { width: 3rem; height: 3rem; display: none; }
  .dust { font: italic 450 .85rem/1 var(--font-display); color: var(--ink-2); margin-top: 1.2rem; }
  .name { font: 600 .74rem/1 var(--font-ui); font-stretch: 80%; letter-spacing: .1em; text-transform: uppercase; }
  .prop:global(.lifted) .thing { translate: 0 -2.8rem; rotate: -12deg; opacity: .35; }
  .prop:global(.lifted) .under { opacity: 1; }
  .prop:global(.has-key) { background: var(--pink); border-color: var(--ink); }
  .prop:global(.has-key) .key { display: block; }
  .prop:global(.has-key) .dust { display: none; }
  .prop:global(.wiggle) .thing { animation: wiggle 1.2s ease-in-out infinite; }
  @keyframes wiggle { 0%, 70%, 100% { rotate: 0deg; } 78% { rotate: -8deg; } 86% { rotate: 7deg; } 94% { rotate: -4deg; } }
  .hint { text-align: center; font: italic 480 1.1rem/1.3 var(--font-display); }
</style>
