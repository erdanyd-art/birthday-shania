---
// The host's dialogue, one card at a time. Always skippable.
// With `heardKey`, the card shows on the guest's first visit to that place only.
import { site } from '../../content/site';

interface Props {
  lines: string[];
  /** Label on the last card's button. */
  doneLabel?: string;
  /** Where to go after the last card. Without it, the card just closes. */
  doneHref?: string;
  /** Where Skip goes. Defaults to doneHref. */
  skipHref?: string;
  heardKey?: string;
  /** "note" is the smaller margin note used inside rooms. */
  variant?: 'card' | 'note';
  class?: string;
}

const {
  lines,
  doneLabel = 'Close',
  doneHref,
  skipHref,
  heardKey,
  variant = 'card',
  class: className,
} = Astro.props;

const many = lines.length > 1;
---

<aside
  class:list={['cues', `cues--${variant}`, className]}
  aria-label={`${site.host}, the host`}
  data-cues
  data-lines={JSON.stringify(lines)}
  data-done-label={doneLabel}
  data-done-href={doneHref}
  data-skip-href={skipHref}
  data-heard-key={heardKey}
  hidden={heardKey ? true : undefined}
>
  <p class="who">{site.host}</p>
  <p class="voice line" data-line aria-live="polite">{lines[0]}</p>
  <div class="controls">
    {many && <span class="count" data-count>1 / {lines.length}</span>}
    {many && <button type="button" class="btn ghost" data-skip>Skip</button>}
    <button type="button" class="btn" data-next>{many ? 'Next' : doneLabel}</button>
  </div>
</aside>

<script>
  import { hasHeard, markHeard } from '../lib/progress';
  import { reducedMotion } from '../lib/motion';

  for (const el of document.querySelectorAll<HTMLElement>('[data-cues]')) setup(el);

  function setup(el: HTMLElement) {
    const lines = JSON.parse(el.dataset.lines ?? '[]') as string[];
    const lineEl = el.querySelector<HTMLElement>('[data-line]')!;
    const countEl = el.querySelector<HTMLElement>('[data-count]');
    const next = el.querySelector<HTMLButtonElement>('[data-next]')!;
    const skip = el.querySelector<HTMLButtonElement>('[data-skip]');
    const key = el.dataset.heardKey;
    const doneLabel = el.dataset.doneLabel ?? 'Close';
    let i = 0;

    // A room note appears on the first visit only, whether or not it's dismissed.
    if (key && !hasHeard(key)) {
      el.hidden = false;
      markHeard(key);
    }

    const render = () => {
      lineEl.textContent = lines[i] ?? '';
      if (countEl) countEl.textContent = `${i + 1} / ${lines.length}`;
      next.textContent = i === lines.length - 1 ? doneLabel : 'Next';
      if (!reducedMotion()) {
        lineEl.animate(
          [{ opacity: 0, transform: 'translateY(6px)' }, { opacity: 1, transform: 'none' }],
          { duration: 240, easing: 'cubic-bezier(.2,.75,.25,1)' },
        );
      }
      el.dispatchEvent(new CustomEvent('cues:line', { bubbles: true, detail: { index: i } }));
    };

    const close = () => {
      if (reducedMotion()) {
        el.hidden = true;
        return;
      }
      el.animate([{ opacity: 1 }, { opacity: 0, transform: 'translateY(8px)' }], {
        duration: 220,
        easing: 'ease-in',
      }).finished.then(() => { el.hidden = true; });
    };

    const finish = (how: 'done' | 'skip') => {
      el.dispatchEvent(new CustomEvent(`cues:${how}`, { bubbles: true }));
      const href = how === 'skip' ? (el.dataset.skipHref ?? el.dataset.doneHref) : el.dataset.doneHref;
      if (href) window.location.href = href;
      else close();
    };

    next.addEventListener('click', () => {
      if (i < lines.length - 1) {
        i += 1;
        render();
      } else {
        finish('done');
      }
    });
    skip?.addEventListener('click', () => finish('skip'));

    el.addEventListener('cues:restart', () => {
      i = 0;
      el.hidden = false;
      render();
    });
  }
</script>

<style>
  .cues {
    background: var(--card);
    color: var(--ink);
    border-top: 3px solid var(--cherry);
    padding: 1rem 1.15rem .95rem;
    box-shadow: 0 8px 18px color-mix(in srgb, var(--ink) 14%, transparent);
    max-width: 34rem;
  }
  .who {
    font: 600 .7rem/1 var(--font-ui);
    font-stretch: 75%;
    letter-spacing: .24em;
    text-transform: uppercase;
    color: var(--cherry);
  }
  .line {
    font-size: clamp(1.18rem, 4.4vw, 1.42rem);
    margin: .6rem 0 .9rem;
  }
  .controls {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: flex-end;
    gap: .55rem;
  }
  .count {
    margin-right: auto;
    font: 500 .8rem/1 var(--font-ui);
    font-variant-numeric: tabular-nums;
    color: var(--ink-2);
  }
  /* Ambrose's ink always reads on card, even when a room is dark. */
  .cues :global(.btn.ghost) { color: var(--cherry); }

  .cues--note {
    border-top-width: 2px;
    padding: .85rem 1rem .8rem;
    box-shadow: 0 4px 10px color-mix(in srgb, var(--ink) 10%, transparent);
    rotate: -.6deg;
  }
  .cues--note .line { font-size: clamp(1.05rem, 3.8vw, 1.2rem); margin: .45rem 0 .6rem; }
</style>
