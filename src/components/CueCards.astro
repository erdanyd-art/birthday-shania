---
// The host's cue cards on the stage, one at a time. Always skippable.
// Each card can carry a pose and a bit of stage business; the page acts on them
// through the `cues:line` event. `cues:done` and `cues:skip` can be cancelled
// (preventDefault) when the page wants to finish with its own exit.
import { site } from '../../content/site';
import type { Cue } from '../../content/types';

interface Props {
  cues: Cue[];
  /** Label on the last card's button, unless the card names its own. */
  doneLabel?: string;
  /** Where to go after the last card. Without it, the card just closes. */
  doneHref?: string;
  /** Where Skip goes. Defaults to doneHref. */
  skipHref?: string;
  class?: string;
}

const { cues, doneLabel = 'Close', doneHref, skipHref, class: className } = Astro.props;

const many = cues.length > 1;
const first = cues[0]!;
const label = (i: number) => cues[i]?.button ?? (i === cues.length - 1 ? doneLabel : 'Next');
---

<aside
  class:list={['cues', className]}
  aria-label={`${site.host}, the host`}
  data-cues
  data-script={JSON.stringify(cues)}
  data-done-label={doneLabel}
  data-done-href={doneHref}
  data-skip-href={skipHref}
>
  <p class="who">{site.host}</p>
  <p class="voice line" data-line aria-live="polite">{first.say}</p>
  <div class="controls">
    {many && <span class="count" data-count>1 / {cues.length}</span>}
    {many && <button type="button" class="btn ghost" data-skip>Skip</button>}
    <button type="button" class="btn" data-next>{label(0)}</button>
  </div>
</aside>

<script>
  import { navigate } from 'astro:transitions/client';
  import type { Cue } from '../../content/types';
  import { reducedMotion } from '../lib/motion';
  import { onPage } from '../lib/page';
  import { play } from '../lib/sound';

  onPage((signal) => {
    for (const el of document.querySelectorAll<HTMLElement>('[data-cues]')) setup(el, signal);
  });

  function setup(el: HTMLElement, signal: AbortSignal) {
    const cues = JSON.parse(el.dataset.script ?? '[]') as Cue[];
    const lineEl = el.querySelector<HTMLElement>('[data-line]')!;
    const countEl = el.querySelector<HTMLElement>('[data-count]');
    const next = el.querySelector<HTMLButtonElement>('[data-next]')!;
    const skip = el.querySelector<HTMLButtonElement>('[data-skip]');
    const doneLabel = el.dataset.doneLabel ?? 'Close';
    const label = (i: number) => cues[i]?.button ?? (i === cues.length - 1 ? doneLabel : 'Next');
    let i = 0;

    const render = () => {
      const cue = cues[i]!;
      lineEl.textContent = cue.say;
      if (countEl) countEl.textContent = `${i + 1} / ${cues.length}`;
      next.textContent = label(i);
      play('host');
      if (!reducedMotion()) {
        lineEl.animate(
          [{ opacity: 0, transform: 'translateY(6px)' }, { opacity: 1, transform: 'none' }],
          { duration: 240, easing: 'cubic-bezier(.2,.75,.25,1)' },
        );
      }
      el.dispatchEvent(new CustomEvent('cues:line', { bubbles: true, detail: { index: i, cue } }));
    };

    const close = () => {
      if (reducedMotion()) {
        el.hidden = true;
        return;
      }
      el.animate([{ opacity: 1 }, { opacity: 0, transform: 'translateY(8px)' }], {
        duration: 220,
        easing: 'ease-in',
      }).finished.then(() => { el.hidden = true; });
    };

    // Read the destination at click time: the page may point it somewhere new after load.
    const finish = (how: 'done' | 'skip') => {
      const proceed = el.dispatchEvent(new CustomEvent(`cues:${how}`, { bubbles: true, cancelable: true }));
      if (!proceed) return;
      const href = how === 'skip' ? (el.dataset.skipHref ?? el.dataset.doneHref) : el.dataset.doneHref;
      if (href) void navigate(href);
      else close();
    };

    next.addEventListener('click', () => {
      if (i < cues.length - 1) {
        i += 1;
        render();
      } else {
        finish('done');
      }
    }, { signal });
    skip?.addEventListener('click', () => finish('skip'), { signal });

    el.addEventListener('cues:restart', () => {
      i = 0;
      el.hidden = false;
      render();
    }, { signal });
  }
</script>

<style>
  .cues {
    background: var(--card);
    color: var(--ink);
    border-top: 3px solid var(--cherry);
    padding: 1rem 1.15rem .95rem;
    box-shadow: 0 8px 18px color-mix(in srgb, var(--ink) 14%, transparent);
    max-width: 34rem;
  }
  .who {
    font: 600 .74rem/1 var(--font-ui);
    font-stretch: 75%;
    letter-spacing: .24em;
    text-transform: uppercase;
    color: var(--cherry);
  }
  .line {
    font-size: clamp(1.18rem, 4.4vw, 1.42rem);
    margin: .6rem 0 .9rem;
  }
  .controls {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: flex-end;
    gap: .55rem;
  }
  .count {
    margin-right: auto;
    font: 500 .8rem/1 var(--font-ui);
    font-variant-numeric: tabular-nums;
    color: var(--ink-2);
  }
  /* Ambrose's ink always reads on card, even when a room is dark. */
  .cues :global(.btn.ghost) { color: var(--cherry); }
</style>
