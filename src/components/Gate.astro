---
// A locked door in front of a room. Ambrose explains a short game; winning it (or asking
// him to let you through) punches the guest's ticket and opens the room. Every game can be
// skipped: "Let me through" appears after a little while, or as soon as someone struggles.
// Games are slotted in and report back with the `game:won` and `game:struggle` events.
import Guide from './Guide.astro';
import { stops, type StopId } from '../lib/rooms';

interface Props {
  stop: StopId;
  title: string;
  /** Ambrose's instructions for the game. */
  line: string;
  /** "night" for the dark rooms. */
  tone?: 'paper' | 'night';
}

const { stop, title, line, tone = 'paper' } = Astro.props;
const number = stops.findIndex((s) => s.id === stop) + 1;
---

<section class:list={['gate', `gate--${tone}`]} data-gate={stop} aria-labelledby={`gate-${stop}`}>
  <div class="play-area" data-gate-play>
    <header class="head">
      <p class="kicker">Door {number} of {stops.length} · Locked</p>
      <h2 class="title" id={`gate-${stop}`}>{title}</h2>
    </header>
    <Guide line={line} />
    <div class="game-slot"><slot /></div>
    <button type="button" class="btn ghost let-through" data-gate-skip hidden>Let me through</button>
  </div>

  <div class="won" data-gate-won hidden>
    <div class="ticket" aria-hidden="true">
      <span class="t-admit">Admit one</span>
      <span class="holes">{stops.map(() => <span class="hole" />)}</span>
    </div>
    <p class="won-line" data-gate-won-line aria-live="polite">The door is open.</p>
    <button type="button" class="btn" data-gate-enter>Go in <span aria-hidden="true">→</span></button>
  </div>
</section>

<script>
  import { markUnlocked, readProgress } from '../lib/progress';
  import { later, onPage } from '../lib/page';
  import type { StopId } from '../lib/rooms';
  import { play } from '../lib/sound';

  onPage((signal) => {
    const gate = document.querySelector<HTMLElement>('[data-gate]');
    if (!gate) return;
    const stop = gate.dataset.gate as StopId;
    if (readProgress().unlocked.includes(stop)) return;

    const playArea = gate.querySelector<HTMLElement>('[data-gate-play]')!;
    const won = gate.querySelector<HTMLElement>('[data-gate-won]')!;
    const wonLine = gate.querySelector<HTMLElement>('[data-gate-won-line]')!;
    const skip = gate.querySelector<HTMLButtonElement>('[data-gate-skip]')!;
    const offerSkip = () => { skip.hidden = false; };
    later(signal, 15000, offerSkip);
    gate.addEventListener('game:struggle', offerSkip, { signal });

    let done = false;
    const open = (how: 'won' | 'skipped') => {
      if (done) return;
      done = true;
      markUnlocked(stop);
      const punched = readProgress().unlocked.length;
      gate.querySelectorAll('.hole').forEach((hole, i) => hole.classList.toggle('punched', i < punched));
      wonLine.textContent = how === 'won' ? 'The door is open. Ticket punched.' : 'Ambrose lets you through. Ticket punched anyway.';
      playArea.hidden = true;
      won.hidden = false;
      play('tear');
      later(signal, 350, () => play('host'));
      window.scrollTo({ top: 0 });
      gate.querySelector<HTMLButtonElement>('[data-gate-enter]')!.focus();
    };
    gate.addEventListener('game:won', () => later(signal, 650, () => open('won')), { signal });
    skip.addEventListener('click', () => open('skipped'), { signal });

    gate.querySelector('[data-gate-enter]')!.addEventListener('click', () => {
      document.documentElement.setAttribute('data-unlocked', readProgress().unlocked.join(' '));
      window.scrollTo({ top: 0 });
      play('paper');
      window.dispatchEvent(new Event('gate:open'));
    }, { signal });
  });
</script>

<style>
  .gate {
    display: grid;
    min-height: calc(100dvh - var(--chrome-h) - 4.5rem);
    padding: clamp(1.25rem, 4vw, 2.5rem) var(--gutter-r) 3rem var(--gutter-l);
    background:
      radial-gradient(ellipse 80% 50% at 50% 40%, color-mix(in srgb, var(--edge) 80%, transparent), transparent 75%),
      color-mix(in srgb, var(--card) 55%, var(--paper));
  }
  .gate--night {
    background: radial-gradient(ellipse 70% 50% at 50% 35%, color-mix(in srgb, var(--deep) 70%, transparent), transparent 80%), var(--ink);
    color: var(--paper);
  }
  .play-area, .won {
    width: min(100%, 34rem);
    margin: 0 auto;
    display: grid;
    gap: 1.25rem;
    align-content: start;
  }
  .head { display: grid; gap: .4rem; }
  .title { font-size: clamp(2rem, 8vw, 3rem); }
  .game-slot { display: grid; justify-items: center; }
  .let-through { justify-self: center; }
  .gate--night .let-through { color: var(--paper); }

  .won { align-content: center; justify-items: center; text-align: center; min-height: 60dvh; }
  .ticket {
    display: grid;
    gap: .7rem;
    justify-items: center;
    padding: 1.1rem 1.6rem;
    background: var(--card);
    color: var(--ink);
    outline: 1px solid var(--cherry);
    outline-offset: -6px;
    rotate: -2deg;
    box-shadow: 0 10px 22px color-mix(in srgb, var(--ink) 22%, transparent);
    animation: punch-in .5s var(--ease-arrive);
  }
  @keyframes punch-in { from { translate: 0 18px; opacity: 0; } }
  .t-admit {
    font: 600 .8rem/1 var(--font-ui);
    font-stretch: 75%;
    letter-spacing: .3em;
    text-transform: uppercase;
    color: var(--cherry);
  }
  .holes { display: flex; gap: .7rem; }
  .hole {
    width: 1.4rem;
    height: 1.4rem;
    border-radius: 50%;
    border: 1.5px dashed var(--cherry);
  }
  .hole:global(.punched) { border-style: solid; border-color: var(--ink); background: var(--pink); }
  .won-line { font: italic 480 clamp(1.25rem, 5vw, 1.6rem)/1.3 var(--font-display); }
</style>
