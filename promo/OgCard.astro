---
// The link-preview image (1200 × 630) shown when the site is shared on WhatsApp, Instagram…
// Dev only, like the carousel: `npm run og` photographs it into public/og.png.
// Re-run it whenever the title or the date in content/site.ts changes.
import '@fontsource-variable/fraunces/full.css';
import '@fontsource-variable/fraunces/full-italic.css';
import '@fontsource-variable/instrument-sans/standard.css';
import '../src/styles/global.css';
import Facade from '../src/components/Facade.astro';
import Ambrose from '../src/components/Ambrose.astro';
import { site } from '../content/site';
---
<html lang="en"><head><meta charset="utf-8" /><title>Link preview</title></head>
<body class="og">
  <div class="card" data-slide="og">
    <div class="valance"></div>
    <div class="words">
      <p class="kick">Opening night · {site.openingNight.label}</p>
      <p class="name">{site.title}</p>
      <p class="line">A small show in five rooms.<br />Doors are open.</p>
    </div>
    <div class="theatre">
      <Facade />
      <div class="host"><Ambrose wire={false} decorative /></div>
    </div>
  </div>
</body></html>
<style>
  :global(body.og) { margin: 0; background: var(--deep); }
  .card {
    position: relative; width: 1200px; height: 630px; overflow: hidden;
    display: grid; grid-template-columns: 1fr 470px; align-items: center; gap: 40px;
    padding: 40px 70px 0 80px; box-sizing: border-box;
    background: repeating-linear-gradient(90deg, var(--deep) 0 18px, color-mix(in srgb, var(--deep) 68%, var(--cherry)) 32px, var(--deep) 46px);
  }
  .valance { position: absolute; inset: 0 0 auto; height: 46px; background: radial-gradient(circle at 50% 0, var(--cherry) 69%, transparent 71%) 0 0 / 56px 46px repeat-x; }
  .words { display: grid; gap: 22px; color: var(--paper); }
  .kick { font: 600 20px/1 var(--font-ui); font-stretch: 75%; letter-spacing: .24em; text-transform: uppercase; color: var(--pink); }
  .name { font: 620 92px/.98 var(--font-display); font-variation-settings: 'opsz' 72, 'SOFT' 60; letter-spacing: -.015em; }
  .line { font: italic 470 34px/1.25 var(--font-display); font-variation-settings: 'opsz' 28, 'SOFT' 80, 'WONK' 1; color: color-mix(in srgb, var(--paper) 88%, var(--pink)); }
  .theatre { position: relative; align-self: end; height: 580px; }
  .theatre :global(.facade) { height: 100%; width: auto; filter: drop-shadow(0 18px 30px rgba(0,0,0,.35)); }
  .host { position: absolute; left: 66%; bottom: 3.5%; width: 21%; }
  .host :global(svg) { width: 100%; height: auto; scale: -1 1; }
</style>
